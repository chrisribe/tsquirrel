---
import Layout from '../layouts/Layout.astro';
---
<script>
  //import fetch from 'node-fetch';

  // Fetch data from the API at build time
  const fetchData = async () => {
    const res = await fetch('http://localhost:3000/showUsers');
    const data = await res.json();
    return data;
  }

  var data = await fetchData();
  document.getElementById('data').innerText = JSON.stringify(data, null, 2);
</script>

<Layout title="Api demo">
	<main>
    <h1>Data from API:</h1>
    <div class="instructions">
      <div id="data"></div>
    </div>
  </main>
</Layout>


<style>
	main {
		margin: auto;
		padding: 1rem;
		width: 800px;
		max-width: calc(100% - 2rem);
		color: white;
		font-size: 20px;
		line-height: 1.6;
	}
	h1 {
		font-size: 4rem;
		font-weight: 700;
		line-height: 1;
		text-align: center;
		margin-bottom: 1em;
	}
	.instructions {
		margin-bottom: 2rem;
		border: 1px solid rgba(var(--accent-light), 25%);
		background: linear-gradient(rgba(var(--accent-dark), 66%), rgba(var(--accent-dark), 33%));
		padding: 1.5rem;
		border-radius: 8px;
	}
</style>