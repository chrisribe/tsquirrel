<% const {event} = pageData %>

<li id="event-<%= event.id %>">
  <figure>
    <img src="<%= event.event_picture || '/static/img/selfie-friends.jpg' %>" alt="Event Picture">
  </figure>
  <div>
    <a href="/events/<%= event.uuid %>/gallery" style="text-decoration: none; color: inherit;">
      <hgroup>
        <h2><%= event.title %></h2>
        <p><%= event.description %></p>
      </hgroup>
    </a>
    <table class="striped">
      <tbody>
        <tr>
          <th>When ?</th>
          <td>
            <%= new Date(event.date).toLocaleString('en-US', {
              weekday: 'long',
              year: 'numeric',
              month: 'long',
              day: 'numeric',
              hour: 'numeric',
              minute: 'numeric',
              hour12: true
            }) %>
          </td>
        </tr>
        <tr>
          <th>Location</th>
          <td><%= event.location %></td>
        </tr>
        <tr>
          <th>Status</th>
          <td><%= event.status || 'Active' %></td>
        </tr>
      </tbody>
    </table>
    <!-- Delete button -->
    <button class="delete-event" 
        hx-delete="/events/<%= event.id %>"
        hx-target="#event-<%= event.id %>"
        hx-swap="outerHTML"
        hx-confirm="Are you sure you want to delete this event?"
        aria-label="Delete event">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor">
        <path d="M3 6h18M8 6V4a2 2 0 012-2h4a2 2 0 012 2v2m3 0v14a2 2 0 01-2 2H7a2 2 0 01-2-2V6h14zM10 11v6M14 11v6"/>
      </svg>
    </button>   
  </div>
</li>