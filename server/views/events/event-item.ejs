<% const {event, eventType} = pageData %>
<% const isUpcoming = eventType === 'upcoming' || (new Date(event.date) > new Date()) %>
<% 
  // Dynamic image selection: user selected -> first photo -> default
  let eventImage = '/static/img/selfie-friends.jpg'; // default
  if (event.first_photo_url) {
    eventImage = event.first_photo_url; // first uploaded photo
  }
  if (event.event_picture) {
    eventImage = event.event_picture; // user selected cover
  }
%>

<li id="event-<%= event.id %>" class="event-item <%= isUpcoming ? 'upcoming-event' : 'past-event' %>">
  <figure>
    <img src="<%= eventImage %>" alt="<%= event.title %> Picture" class="event-cover-image">
    <% if (event.first_photo_url && !event.event_picture) { %>
      <div class="auto-cover-badge" title="Using first uploaded photo">📷</div>
    <% } %>
  </figure>
  <div class="event-content">
    <a href="/events/<%= event.uuid %>/gallery" style="text-decoration: none; color: inherit;">
      <hgroup>
        <h2><%= event.title %></h2>
        <p><%= event.description %></p>
      </hgroup>
    </a>
    <table class="striped">
      <tbody>
        <tr>
          <th>When ?</th>
          <td>
            <%= new Date(event.date).toLocaleString('en-US', {
              weekday: 'long',
              year: 'numeric',
              month: 'long',
              day: 'numeric',
              hour: 'numeric',
              minute: 'numeric',
              hour12: true
            }) %>
          </td>
        </tr>
        <tr>
          <th>Location</th>
          <td><%= event.location %></td>
        </tr>
        <tr>
          <th>Status</th>
          <td>
            <span class="status-badge <%= isUpcoming ? 'status-upcoming' : 'status-past' %>">
              <%= isUpcoming ? 'upcoming' : 'completed' %>
            </span>
          </td>
        </tr>
        <% if (event.tags && event.tags.trim()) { %>
        <tr>
          <th>Tags</th>
          <td>
            <div class="event-tags">
              <% event.tags.split(',').forEach(function(tag) { %>
                <% if (tag.trim()) { %>
                  <span class="tag-badge"><%= tag.trim() %></span>
                <% } %>
              <% }) %>
            </div>
          </td>
        </tr>
        <% } %>
      </tbody>
    </table>
    
    <!-- Action buttons based on event type -->
    <div class="event-actions">
      <% if (isUpcoming) { %>
        <!-- Upcoming event actions -->
        <button class="action-btn secondary edit-event-btn" 
                hx-get="/events/<%= event.id %>/edit"
                hx-target="#editEventModal .modal-content"
                hx-trigger="click"
                onclick="document.getElementById('editEventModal').showModal()"
                title="Edit Event">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor">
            <path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"/>
            <path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/>
          </svg>
          Edit
        </button>
        <a href="/events/<%= event.uuid %>/gallery" class="action-btn secondary">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor">
            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
            <circle cx="12" cy="12" r="3"/>
          </svg>
          View Details
        </a>
      <% } else { %>
        <!-- Past event actions -->
        <a href="/events/<%= event.uuid %>/gallery" class="action-btn primary">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor">
            <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
            <circle cx="8.5" cy="8.5" r="1.5"/>
            <polyline points="21,15 16,10 5,21"/>
          </svg>
          View Gallery
        </a>
        <button class="action-btn secondary edit-event-btn" 
                hx-get="/events/<%= event.id %>/edit"
                hx-target="#editEventModal .modal-content"
                hx-trigger="click"
                onclick="document.getElementById('editEventModal').showModal()"
                title="Edit Event - Add memories, thank you notes, or select cover photo">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor">
            <path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"/>
            <path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/>
          </svg>
          Edit
        </button>
        <button class="action-btn secondary" title="Share Event">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor">
            <circle cx="18" cy="5" r="3"/>
            <circle cx="6" cy="12" r="3"/>
            <circle cx="18" cy="19" r="3"/>
            <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/>
            <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/>
          </svg>
          Share
        </button>
      <% } %>
      
      <!-- Delete button for both types -->
      <button class="action-btn delete-event" 
          hx-delete="/events/<%= event.id %>"
          hx-target="#event-<%= event.id %>"
          hx-swap="outerHTML"
          hx-confirm="Are you sure you want to delete this event?"
          title="Delete Event">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor">
          <path d="M3 6h18M8 6V4a2 2 0 012-2h4a2 2 0 012 2v2m3 0v14a2 2 0 01-2 2H7a2 2 0 01-2-2V6h14zM10 11v6M14 11v6"/>
        </svg>
        Delete
      </button>   
    </div>
  </div>
</li>