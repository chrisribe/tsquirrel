<!-- Error display area -->
<% if (pageData.error) { %>
  <div class="error" role="alert">
    <%= pageData.error %>
  </div>
<% } %>

<label for="title">Title</label>
<input type="text" id="title" name="title" 
        value="<%= pageData.formData?.title || '' %>">

<label for="description">Description</label>
<textarea id="description" name="description"><%= pageData.formData?.description || '' %></textarea>

<label for="date">Date</label>
<input type="datetime-local" id="date" name="date" 
        value="<%= pageData.formData?.date || new Date().toISOString().substring(0, 16) %>" required>

<label for="location">Location</label>
<input type="text" id="location" name="location" 
        value="<%= pageData.formData?.location || '' %>">

<label for="category">Category</label>
<select id="category" name="category">
  <option value="">Select category...</option>
  <option value="birthday" <%= pageData.formData?.category === 'birthday' ? 'selected' : '' %>>Birthday</option>
  <option value="wedding" <%= pageData.formData?.category === 'wedding' ? 'selected' : '' %>>Wedding</option>
  <option value="party" <%= pageData.formData?.category === 'party' ? 'selected' : '' %>>Party</option>
  <option value="meeting" <%= pageData.formData?.category === 'meeting' ? 'selected' : '' %>>Meeting</option>
  <option value="conference" <%= pageData.formData?.category === 'conference' ? 'selected' : '' %>>Conference</option>
  <option value="other" <%= pageData.formData?.category === 'other' ? 'selected' : '' %>>Other</option>
</select>

<label for="tags">Tags</label>
<input type="text" id="tags" name="tags" 
        placeholder="e.g. family, celebration, work (comma-separated)"
        value="<%= pageData.formData?.tags || '' %>">
<small class="field-help">Use comma-separated keywords to categorize your event</small>

<button type="submit" class="button primary">Add Event</button>
