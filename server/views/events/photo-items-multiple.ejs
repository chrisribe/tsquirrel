<% if (pageData.photos && pageData.photos.length > 0) { %>
  <% pageData.photos.forEach((photo, index) => { %>
    <div class="item" data-w="<%= photo.width || 400 %>" data-h="<%= photo.height || 300 %>" data-photo-id="<%= photo.photo_id %>">
      <img src="<%= photo.thumb_url || photo.photo_url %>" 
           alt="<%= photo.original_name || 'Photo' %>" 
           loading="lazy" 
           data-lightbox="gallery"
           data-display="<%= photo.photo_url %>"
           data-original="<%= photo.original_url || photo.photo_url %>"
           style="display: none;">
      
      <div class="photo-loading">
        <div class="loading-placeholder">
          <div class="spinner"></div>
          <p>Processing photo...</p>
        </div>
      </div>
      
      <% if (pageData.isOwner) { %>
        <div class="photo-actions">
          <button class="set-cover-btn" 
                  data-photo-id="<%= photo.photo_id %>"
                  data-event-uuid="<%= pageData.event.uuid %>"
                  title="Set as cover photo">
            🖼️ Set as Cover
          </button>
        </div>
      <% } %>
    </div>
  <% }); %>
<% } %>
