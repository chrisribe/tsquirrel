<div class="gallery-container">
  <div class="gallery-header">
    <h1><%= pageData.event.title %></h1>
    <a href="/events" class="back-btn">← Back</a>
  </div>

  <div class="action-bar">
    <div class="upload-section">
      <form 
        id="uploadForm"
        hx-post="/events/<%= pageData.event.uuid %>/photos"
        hx-encoding="multipart/form-data"
        hx-target="#flexGallery"
        hx-swap="beforeend">
        
        <label for="photo" class="upload-btn" id="uploadLabel">
          📷 Upload Photos
          <input type="file" id="photo" name="photoFile" accept="image/*" multiple required hidden>
        </label>
        
        <div class="upload-status" id="uploadStatus" style="display: none;">
          <div class="uploading">📤 Uploading...</div>
        </div>
      </form>
    </div>

    <% if (pageData.event.qr_code_url) { %>
    <div class="qr-section">
      <button id="shareBtn" class="share-btn" onclick="Gallery.toggleShare()">
        <span class="share-icon">📤</span>
        <span class="share-text">Share Gallery</span>
        <span class="share-arrow">▼</span>
      </button>
    </div>
    <% } %>
  </div>

  <% if (pageData.event.qr_code_url) { %>
  <div id="shareContent" class="share-content" style="display: none;">
    <div class="qr-container">
      <img src="<%= pageData.event.qr_code_url %>" alt="QR Code for <%= pageData.event.title %> Gallery" class="qr-code">
      <p class="qr-instruction">Scan with phone camera</p>
      <button onclick="Gallery.copyCurrentUrl()" class="copy-btn">
        <span class="copy-text">📋 Copy Link</span>
        <span class="copy-check" style="display: none;">✓ Copied!</span>
      </button>
    </div>
  </div>
  <% } %>
  <div class="photos-section">
    <div class="flex-images" id="flexGallery">
      <% if (pageData.photos && pageData.photos.length > 0) { %>
        <% pageData.photos.forEach((photo, index) => { %>
          <div class="item" data-w="<%= photo.width || 400 %>" data-h="<%= photo.height || 300 %>" data-photo-id="<%= photo.photo_id %>">
            <img src="<%= photo.thumb_url || photo.photo_url %>" 
                 alt="Photo <%= index + 1 %>" 
                 loading="lazy" 
                 data-lightbox="gallery"
                 data-display="<%= photo.photo_url %>"
                 data-original="<%= photo.original_url || photo.photo_url %>">
            
            <% if (pageData.isOwner) { %>
              <div class="photo-actions">
                <button class="set-cover-btn" 
                        data-photo-id="<%= photo.photo_id %>"
                        data-event-uuid="<%= pageData.event.uuid %>"
                        title="Set as cover photo">
                  🖼️ Set as Cover
                </button>
                <button class="delete-photo-btn" 
                        data-photo-id="<%= photo.photo_id %>"
                        data-event-uuid="<%= pageData.event.uuid %>"
                        title="Delete photo">
                  🗑️ Delete
                </button>
              </div>
            <% } %>
          </div>
        <% }); %>
      <% } %>
    </div>
    
    <% if (!pageData.photos || pageData.photos.length === 0) { %>
      <div class="empty-state">
        <p>No photos yet</p>
        <p class="hint">Share your memories by adding the first photo!</p>
      </div>
    <% } %>
  </div>


</div>