<div class="gallery-container">
  <div class="gallery-header">
    <h1><%= pageData.event.title %></h1>
    <a href="/events" class="back-btn">← Back</a>
  </div>

  <div class="photos-section">
    <div class="photo-grid">
      <% if (pageData.photos && pageData.photos.length > 0) { %>
        <% pageData.photos.forEach(photo => { %>
          <img src="<%= photo.photo_url %>" alt="Photo" loading="lazy">
        <% }); %>
      <% } %>
    </div>
    
    <% if (!pageData.photos || pageData.photos.length === 0) { %>
      <div class="empty-state">
        <p>No photos yet</p>
        <p class="hint">Share your memories by adding the first photo!</p>
      </div>
    <% } %>
  </div>

  <div class="upload-section">
    <form 
      id="uploadForm"
      hx-post="/events/<%= pageData.event.uuid %>/photos"
      hx-encoding="multipart/form-data"
      hx-target=".photo-grid"
      hx-swap="beforeend">
      
      <label for="photo" class="upload-btn">
        📷 Add Photo
        <input type="file" id="photo" name="photoFile" accept="image/*" required hidden>
      </label>
      
      <button type="submit" class="share-btn">Share</button>
    </form>
  </div>
</div>

<style>
  .gallery-container .gallery-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 2rem;
  }

  .gallery-container .gallery-header h1 {
    margin: 0;
    font-size: 1.8rem;
  }

  .gallery-container .back-btn {
    text-decoration: none;
    padding: 0.5rem 1rem;
    background: #f0f0f0;
    border-radius: 8px;
    color: #333;
  }

  .gallery-container .photo-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .gallery-container .photo-grid img {
    width: 100%;
    height: 200px;
    object-fit: cover;
    border-radius: 12px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.1);
  }

  .gallery-container .empty-state {
    text-align: center;
    padding: 3rem 1rem;
    color: #666;
  }

  .gallery-container .hint {
    font-size: 0.9rem;
    margin-top: 0.5rem;
  }

  .gallery-container .upload-section {
    border-top: 1px solid #eee;
    padding-top: 2rem;
    max-width: 50%;
    margin: 0 auto;
  }

  .gallery-container form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .gallery-container .upload-btn {
    background: #007bff;
    color: white;
    padding: 1rem;
    border-radius: 8px;
    cursor: pointer;
    font-size: 1rem;
    text-align: center;
    width: 100%;
    display: block;
  }

  .gallery-container .share-btn {
    background: #28a745;
    color: white;
    border: none;
    padding: 1rem;
    border-radius: 8px;
    cursor: pointer;
    font-size: 1rem;
    width: 100%;
  }
</style>