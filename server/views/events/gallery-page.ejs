<div class="gallery-container">
  <div class="gallery-header">
    <h1><%= pageData.event.title %></h1>
    <a href="/events" class="back-btn">← Back</a>
  </div>

  <div class="upload-section">
    <form 
      id="uploadForm"
      hx-post="/events/<%= pageData.event.uuid %>/photos"
      hx-encoding="multipart/form-data"
      hx-target="#flexGallery"
      hx-swap="beforeend">
      
      <label for="photo" class="upload-btn" id="uploadLabel">
        📷 Upload Photos
        <input type="file" id="photo" name="photoFile" accept="image/*" required hidden>
      </label>
      
      <div class="upload-status" id="uploadStatus" style="display: none;">
        <div class="uploading">📤 Uploading...</div>
      </div>
    </form>
  </div>
  <div class="photos-section">
    <div class="flex-images" id="flexGallery">
      <% if (pageData.photos && pageData.photos.length > 0) { %>
        <% pageData.photos.forEach((photo, index) => { %>
          <div class="item" data-w="<%= photo.width || 400 %>" data-h="<%= photo.height || 300 %>" data-photo-id="<%= photo.photo_id %>">
            <img src="<%= photo.thumb_url || photo.photo_url %>" 
                 alt="Photo <%= index + 1 %>" 
                 loading="lazy" 
                 data-lightbox="gallery"
                 data-display="<%= photo.photo_url %>"
                 data-original="<%= photo.original_url || photo.photo_url %>">
            
            <% if (pageData.isOwner) { %>
              <div class="photo-actions">
                <button class="set-cover-btn" 
                        data-photo-id="<%= photo.photo_id %>"
                        data-event-uuid="<%= pageData.event.uuid %>"
                        title="Set as cover photo">
                  🖼️ Set as Cover
                </button>
              </div>
            <% } %>
          </div>
        <% }); %>
      <% } %>
    </div>
    
    <% if (!pageData.photos || pageData.photos.length === 0) { %>
      <div class="empty-state">
        <p>No photos yet</p>
        <p class="hint">Share your memories by adding the first photo!</p>
      </div>
    <% } %>
  </div>


</div>