<% const {events, upcomingEvents, pastEvents, eventCounts} = pageData %>

<% if (events && events.length > 0) { %>
  
  <!-- Upcoming Events Section -->
  <% if (upcomingEvents && upcomingEvents.length > 0) { %>
    <section class="events-section upcoming-events">
      <h3 class="section-header">
        Upcoming Events 
        <span class="section-count">(<%= upcomingEvents.length %>)</span>
      </h3>
      <ul class="events-list">
        <% upcomingEvents.forEach(event => { %>
          <%- include('event-item', { pageData: { event, eventType: 'upcoming' } }) %>
        <% }) %>
      </ul>
    </section>
  <% } %>

  <!-- Past Events Section -->
  <% if (pastEvents && pastEvents.length > 0) { %>
    <section class="events-section past-events">
      <h3 class="section-header">
        Past Events 
        <span class="section-count">(<%= pastEvents.length %>)</span>
      </h3>
      <ul class="events-list">
        <% pastEvents.forEach(event => { %>
          <%- include('event-item', { pageData: { event, eventType: 'past' } }) %>
        <% }) %>
      </ul>
    </section>
  <% } %>

<% } else { %>
  <div class="empty-state">
    <div class="empty-state-icon">
      🎉
    </div>
    <h3>Create Your First Event</h3>
    <p>Start planning memorable moments with friends and family. Create events, invite people, and build lasting memories together.</p>
    <button type="button" 
            class="primary-button create-first-event-btn" 
            data-open-modal="addEventModal">
      Create Your First Event
    </button>
    <div class="empty-state-features">
      <div class="feature-item">
        <span class="feature-icon">📅</span>
        <span>Plan events with dates and locations</span>
      </div>
      <div class="feature-item">
        <span class="feature-icon">📷</span>
        <span>Collect photos and memories</span>
      </div>
      <div class="feature-item">
        <span class="feature-icon">🔗</span>
        <span>Share galleries with friends</span>
      </div>
    </div>
  </div>
<% } %>