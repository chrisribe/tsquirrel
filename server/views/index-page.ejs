<section class="hero">
  <div class="hero-content">
    <h1>Share Event Photos<br><span class="hero-highlight">Instantly</span></h1>
    <p class="hero-subtitle">One link. No apps. Everyone uploads.</p>
    
    <% if (user) { %>
      <a href="/galleries" role="button" class="hero-cta">Go to My Galleries</a>
    <% } else { %>
      <div class="hero-buttons">
        <a href="/register" role="button" class="hero-cta">Create Free Gallery</a>
        <a href="/auth/login" role="button" class="outline hero-cta-secondary">Sign In</a>
      </div>
    <% } %>
  </div>
</section>

<section class="container">
  <div class="how-it-works">
    <h2 class="section-title">How it works</h2>
    <div class="steps">
      <div class="step">
        <div class="step-number">1</div>
        <div class="step-content">
          <h4>Create a gallery</h4>
          <p>Give it a name and you're ready to go</p>
        </div>
      </div>
      <div class="step">
        <div class="step-number">2</div>
        <div class="step-content">
          <h4>Share the link</h4>
          <p>Send to guests or print a QR code</p>
        </div>
      </div>
      <div class="step">
        <div class="step-number">3</div>
        <div class="step-content">
          <h4>Everyone uploads</h4>
          <p>No accounts needed for guests</p>
        </div>
      </div>
      <div class="step">
        <div class="step-number">4</div>
        <div class="step-content">
          <h4>Memories collected</h4>
          <p>All photos in one place, forever</p>
        </div>
      </div>
    </div>
    <p class="social-proof">Perfect for weddings, birthday parties, and family reunions.</p>
  </div>
</section>
