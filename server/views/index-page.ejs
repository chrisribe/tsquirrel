<section class="hero">
  <div class="hero-content">
    <h1>Collect Everyone's Photos<br><span class="hero-highlight">Without the Chaos</span></h1>
    <p class="hero-subtitle">One link. No apps. No accounts for guests.</p>
    
    <% if (user) { %>
      <a href="/galleries" role="button" class="hero-cta">Go to My Galleries</a>
    <% } else { %>
      <div class="hero-buttons">
        <a href="/register" role="button" class="hero-cta">Start Your Gallery</a>
        <a href="/auth/login" role="button" class="outline hero-cta-secondary">Sign In</a>
      </div>
    <% } %>
  </div>
</section>

<!-- Problem/Solution Story -->
<section class="container">
  <div class="problem-section">
    <h2 class="section-title">Sound familiar?</h2>
    <div class="pain-points">
      <div class="pain-item">📱 "Send me your photos!" → crickets</div>
      <div class="pain-item">🤷 Uncle Bob: "What's AirDrop?"</div>
      <div class="pain-item">😤 Karen: "I can't access the Google Drive"</div>
      <div class="pain-item">⏰ WeTransfer: "Your link expired"</div>
    </div>
    
    <p class="solution-line">With EventGlimpse, they just click and drop.</p>
    
    <% if (!user) { %>
    <div class="solution-cta">
      <a href="/register" role="button" class="hero-cta">Start Your Gallery</a>
      <p class="cta-subtext">Quick setup. No commitment.</p>
    </div>
    <% } %>
  </div>
</section>
