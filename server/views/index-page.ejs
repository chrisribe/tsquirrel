<section>
  <hgroup>
    <h1>📷 EventGlimpse</h1>
    <p>Simple photo sharing for events</p>
  </hgroup>
  
  <article>
    <h3>How it works</h3>
    <ol>
      <li><strong>Create a gallery</strong> - just give it a name</li>
      <li><strong>Share the link</strong> - or print a QR code</li>
      <li><strong>Everyone uploads</strong> - no accounts needed for guests</li>
      <li><strong>Memories collected</strong> - all in one place</li>
    </ol>
  </article>

  <article style="background: var(--card-background-color); padding: 1.5rem; border-radius: 0.5rem;">
    <h3>Trusted & Secure</h3>
    <div class="grid">
      <div style="text-align: center;">
        <p><strong>🔒 Secure Storage</strong></p>
        <small>Photos stored on AWS with encryption</small>
      </div>
      <div style="text-align: center;">
        <p><strong>🔐 Private Links</strong></p>
        <small>Galleries not searchable or public</small>
      </div>
      <div style="text-align: center;">
        <p><strong>✅ You Control Your Data</strong></p>
        <small>Delete photos & galleries anytime</small>
      </div>
    </div>
    <p style="text-align: center; margin-top: 1rem;">
      <small>Used at weddings, birthday parties, and family reunions. <a href="/about">Learn more →</a></small>
    </p>
  </article>
  
  <% if (user) { %>
    <a href="/galleries" role="button">Go to My Galleries</a>
  <% } else { %>
    <div class="grid">
      <a href="/register" role="button">Create Your First Gallery</a>
      <a href="/auth/login" role="button" class="outline">Sign In</a>
    </div>
  <% } %>
</section>
