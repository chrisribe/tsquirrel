<%
  const { stories, categories, activeCategory, activeTag, activeQuery, activeBrief } = pageData;
  const featured = !activeCategory && !activeTag && !activeQuery && !activeBrief && stories.length ? stories[0] : null;
  const feedStories = featured ? stories.slice(1) : stories;
%>

<!-- Squirrel intro -->
<p class="chatter">The internet is a big forest. <strong>We sniff out the good stuff</strong> so you don't have to dig.</p>

<form class="search-form" method="get" action="/" role="search" aria-label="Search stories">
  <input type="search" name="q" value="<%= activeQuery || '' %>" placeholder="Search stories (title, summary, tags)" aria-label="Search stories">
  <% if (activeCategory) { %><input type="hidden" name="category" value="<%= activeCategory %>"><% } %>
  <% if (activeTag) { %><input type="hidden" name="tag" value="<%= activeTag %>"><% } %>
  <% if (activeBrief) { %><input type="hidden" name="brief" value="1"><% } %>
  <button type="submit" class="secondary">Search</button>
  <% if (activeQuery) { %>
    <a href="/" class="search-clear" data-ga-event="search_clear" data-ga-location="top_bar">Clear</a>
  <% } %>
</form>

<% if (activeQuery) { %>
  <p class="chatter">Showing results for <strong>"<%= activeQuery %>"</strong>.</p>
<% } %>

<% if (activeTag) { %>
  <p class="chatter">Showing stories tagged <strong>#<%= activeTag %></strong> — <a href="/" data-ga-event="tag_clear" data-ga-tag="<%= activeTag %>">clear filter</a></p>
<% } %>

<% if (activeBrief) { %>
  <p class="chatter">Showing stories with <strong>Deep Dive</strong>.</p>
<% } %>

<!-- Category filter bar -->
<section class="category-bar">
  <div class="category-scroll">
    <a href="/" class="category-pill <%= !activeCategory && !activeBrief ? 'active' : '' %>" data-ga-event="category_select" data-ga-category="all" data-ga-location="top_bar">🥜 All</a>
    <a href="/?category=hot<%= activeBrief ? '&brief=1' : '' %>" class="category-pill <%= activeCategory === 'hot' ? 'active' : '' %>" data-ga-event="category_select" data-ga-category="hot" data-ga-location="top_bar">🔥 Hot</a>
    <a href="/?brief=1" class="category-pill <%= activeBrief ? 'active' : '' %>" data-ga-event="category_select" data-ga-category="evidence_brief" data-ga-location="top_bar">🔎 Deep Dive</a>
    <% categories.forEach(c => { %>
      <% const categorySlug = String(c.category || '')
           .trim()
           .toLowerCase()
           .replace(/&/g, ' and ')
           .replace(/[^a-z0-9]+/g, '-')
           .replace(/^-+|-+$/g, ''); %>
      <% const footerCategories = Array.isArray(locals.footerCategories) ? locals.footerCategories : []; %>
      <% const indexableSlugs = new Set(footerCategories.map((cat) => cat.slug)); %>
      <% const categoryHref = indexableSlugs.has(categorySlug)
           ? '/category/' + categorySlug
           : '/?category=' + encodeURIComponent(c.category); %>
      <a href="<%= categoryHref %>"
         class="category-pill <%= activeCategory === c.category ? 'active' : '' %>" data-ga-event="category_select" data-ga-category="<%= c.category %>" data-ga-location="top_bar">
        <%= catLabel(c.category) %>
      </a>
    <% }); %>
  </div>
</section>

<!-- Featured strip -->
<% if (featured) { %>
  <a href="/story/<%= featured.slug %>" class="card-featured<%= featured.image_url ? ' has-image' : '' %>" data-ga-event="story_open" data-ga-story-id="<%= featured.id %>" data-ga-story-slug="<%= featured.slug %>" data-ga-location="featured"
     <% if (featured.image_url) { %>style="background-image:url('<%= featured.image_url %>')"<% } %>>
    <div class="featured-eyebrow">🔥 Everyone's chattering about this</div>
    <div class="featured-title"><%= featured.title %></div>
    <% if (featured.summary) { %>
      <div class="featured-summary"><%= featured.summary %></div>
    <% } %>
    <div class="featured-footer">
      <span class="featured-sources">📡 <%= featured.source_count %> source<%= featured.source_count == 1 ? '' : 's' %></span>
      <span class="featured-pill">Read story →</span>
    </div>
  </a>
<% } %>

<p class="section-label">🥜 Fresh stash</p>

<!-- Story feed -->
<section class="story-feed <%= activeQuery ? 'story-feed-search' : '' %>"
         id="story-feed">
  <%- include('partials/story-cards', {
        pageData: { stories: feedStories },
        showHomeAdCard: Boolean(googleAdsenseClient && googleAdsenseHomeEnabled && googleAdsenseHomeFeedSlot),
        googleAdsenseClient,
        googleAdsenseHomeFeedSlot
      }) %>

  <!-- HTMX load-more trigger -->
  <% if (stories.length === 30) { %>
  <div id="load-more"
       class="load-more-wrap"
       hx-get="/api/stories?offset=30<%= activeCategory ? '&category=' + encodeURIComponent(activeCategory) : '' %><%= activeTag ? '&tag=' + encodeURIComponent(activeTag) : '' %><%= activeQuery ? '&q=' + encodeURIComponent(activeQuery) : '' %><%= activeBrief ? '&brief=1' : '' %>"
       hx-trigger="click"
       hx-swap="outerHTML"
       hx-target="#load-more">
    <button type="button" class="secondary outline">Load more stories</button>
  </div>
  <% } %>
</section>
