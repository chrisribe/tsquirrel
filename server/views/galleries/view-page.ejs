<div class="gallery-view">
  <!-- Header -->
  <header class="gallery-header">
    <h1><%= pageData.gallery.title %></h1>
    <div class="header-actions">
      <div class="photo-counter">
        <span id="photoCount"><%= pageData.photoCount %></span> photos
      </div>
      <% if (pageData.gallery.qr_code_url) { %>
        <button class="share-btn" onclick="Gallery.toggleShare()" title="Share this gallery">
          <span class="share-icon">📤</span>
          <span class="share-text">Share</span>
        </button>
      <% } %>
    </div>
  </header>

  <!-- Big Upload Button -->
  <div class="upload-zone">
    <form 
      id="uploadForm"
      hx-post="/g/<%= pageData.gallery.uuid %>/photos"
      hx-encoding="multipart/form-data"
      hx-target="#photoGrid"
      hx-swap="afterbegin"
      hx-on::after-request="Gallery.onUploadComplete(event)">
      
      <label for="photoInput" class="upload-btn-big">
        <span class="upload-icon">📷</span>
        <span class="upload-text">Add Photos</span>
        <input 
          type="file" 
          id="photoInput" 
          name="photoFile" 
          accept="image/*" 
          multiple 
          hidden
          onchange="Gallery.onFilesSelected(this)">
      </label>
      
      <div id="uploadStatus" class="upload-status" style="display: none;">
        <progress id="uploadProgress"></progress>
        <span>Uploading...</span>
      </div>
    </form>
  </div>

  <!-- Photo Grid -->
  <div class="photo-grid" id="photoGrid">
    <% if (pageData.photos && pageData.photos.length > 0) { %>
      <% pageData.photos.forEach((photo, index) => { %>
        <div class="photo-item" data-photo-id="<%= photo.photo_id %>">
          <img 
            src="<%= photo.thumb_url %>" 
            alt="Photo"
            loading="lazy"
            onload="this.classList.add('loaded')"
            onerror="Gallery.retryImage(this)"
            onclick="Gallery.openLightbox('<%= photo.display_url %>', '<%= photo.original_url %>')">
          
          <% if (pageData.isOwner) { %>
            <button 
              class="delete-btn"
              onclick="Gallery.deletePhoto('<%= pageData.gallery.uuid %>', '<%= photo.photo_id %>', this)">
              ×
            </button>
          <% } %>
        </div>
      <% }); %>
    <% } %>
  </div>

  <% if (!pageData.photos || pageData.photos.length === 0) { %>
    <div class="empty-state" id="emptyState">
      <p>No photos yet</p>
      <p class="hint">Be the first to share a memory!</p>
    </div>
  <% } %>

  <!-- Share Modal -->
  <% if (pageData.gallery.qr_code_url) { %>
  <div id="shareModal" class="share-modal" onclick="Gallery.closeShare()" style="display: none;">
    <div class="share-content" onclick="event.stopPropagation()">
      <button class="close-btn" onclick="Gallery.closeShare()">×</button>
      <h2>Share Gallery</h2>
      <div class="qr-display">
        <img src="<%= pageData.gallery.qr_code_url %>" alt="QR Code" class="qr-code-large">
        <p class="qr-hint">Scan with phone camera</p>
      </div>
      <div class="share-link">
        <input type="text" id="shareUrl" value="<%= pageData.shareUrl %>" readonly onclick="this.select()">
        <button onclick="Gallery.copyLink()" class="copy-btn">Copy Link</button>
      </div>
    </div>
  </div>
  <% } %>

  <!-- Lightbox -->
  <div id="lightbox" class="lightbox" onclick="Gallery.closeLightbox()" style="display: none;">
    <button id="lightboxPrev" class="nav-btn prev-btn" onclick="event.stopPropagation(); Gallery.prevPhoto()">‹</button>
    <img id="lightboxImg" src="" alt="Full size photo" onclick="event.stopPropagation()">
    <button id="lightboxNext" class="nav-btn next-btn" onclick="event.stopPropagation(); Gallery.nextPhoto()">›</button>
    <a id="lightboxDownload" href="" download class="download-btn" onclick="event.stopPropagation()">⬇ Download</a>
    <button class="close-btn" onclick="Gallery.closeLightbox()">×</button>
  </div>
</div>
