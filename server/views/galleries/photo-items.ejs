<% pageData.photos.forEach((photo, index) => { %>
  <div class="item photo-new" 
       data-photo-id="<%= photo.photo_id %>"
       data-w="<%= photo.width || 300 %>"
       data-h="<%= photo.height || 200 %>">
    <img 
      src="<%= photo.display_url %>" 
      alt="Photo"
      loading="lazy"
      onload="this.classList.add('loaded')"
      onerror="Gallery.retryImage(this)"
      onclick="Gallery.openLightbox('<%= photo.display_url %>', '<%= photo.original_url %>')">
    
    <% if (pageData.isOwner || pageData.isUploader) { %>
      <button 
        class="delete-btn"
        onclick="event.stopPropagation(); Gallery.deletePhoto('<%= pageData.gallery.uuid %>', '<%= photo.photo_id %>', this)">
        ×
      </button>
    <% } %>
  </div>
<% }); %>

<script>
  // Update counter
  document.getElementById('photoCount').textContent = '<%= pageData.photoCount %>';
  // Hide empty state if it exists
  const empty = document.getElementById('emptyState');
  if (empty) empty.style.display = 'none';
  // Re-layout flex images
  if (window.galleryFlex) window.galleryFlex.layout();
</script>
