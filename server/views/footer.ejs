<footer class="container">
  <small class="footer-tagline">© <%= new Date().getFullYear() %> <strong>TSquirrel</strong> — A squirrel never forgets where it buried its nuts.</small>
  <small class="footer-sub">Powered by RSS + HN · Summarized by AI · Curated by chaos</small>
  <nav class="footer-links" aria-label="Footer links">
    <a href="/deep-dive">Deep Dive</a>
    <a href="/about">About</a>
    <a href="/privacy-policy">Privacy Policy</a>
    <a href="/terms-of-service">Terms of Service</a>
    <a href="/contact">Contact</a>
  </nav>
  <nav class="footer-links footer-links-cats" aria-label="Browse categories">
    <% const footerCategories = Array.isArray(locals.footerCategories) ? locals.footerCategories : []; %>
    <% if (footerCategories.length) { %>
      <span class="footer-links-label">Browse:</span>
      <% footerCategories.forEach((cat) => { %>
        <a href="/category/<%= cat.slug %>"><%= cat.category %></a>
      <% }); %>
    <% } else { %>
      <span class="footer-links-label">Browse:</span>
      <a href="/category/politics">Politics</a>
      <a href="/category/world">World</a>
      <a href="/category/business">Business</a>
      <a href="/category/technology">Technology</a>
      <a href="/category/ai">AI</a>
    <% } %>
  </nav>
</footer>
