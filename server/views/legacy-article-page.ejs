<%
  const { article } = pageData;
%>
<article class="legacy-article">
  <header class="story-detail-header">
    <div class="story-meta">
      <span class="story-category legacy-badge">📰 Archive</span>
      <span class="story-time">TSquirrel Classic</span>
    </div>
    <h1><%= article.title %></h1>
    <% if (article.description) { %>
      <p class="story-summary-large"><%= article.description %></p>
    <% } %>
  </header>

  <% if (article.source_url) { %>
  <div class="source-list">
    <h3>Original Source</h3>
    <a href="<%= article.source_url %>" target="_blank" rel="noopener noreferrer" class="source-item">
      <span class="source-name">Source</span>
      <span class="source-title"><%= article.source_url.replace(/^https?:\/\/(?:www\.)?/, '').split('/')[0] %></span>
      <span class="source-arrow">↗ Read original article</span>
    </a>
  </div>
  <% } %>

  <div style="margin-top:2rem; padding:1rem; background:#f9fafb; border-radius:10px; border:1px solid #e5e7eb;">
    <p style="margin:0; font-size:.9rem; color:#6b7280;">
      🐿️ <strong>TSquirrel is back.</strong> We're now an AI-powered news aggregator — 
      <a href="/">see what's trending today →</a>
    </p>
  </div>

  <div style="margin-top:1.5rem">
    <a href="/" class="secondary">← Back to trending</a>
  </div>
</article>
