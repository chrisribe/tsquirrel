<%# Upgrade Modal Partial - pass type ('gallery-limit' or 'zip-download') and limits from GalleryService.getAllLimits() %>
<%
  const userTier = user?.tier || 'free';
  const isEventTier = userTier === 'event';
  const isPartyPackTier = userTier === 'partypack';
  const eventTier = limits?.event || {};
  const partyTier = limits?.partypack || {};
  const formatGalleries = (n) => n >= 100 ? 'Unlimited' : n;
  const formatRetention = (days) => days >= 365 ? '1 year' : `${days} days`;
%>
<div id="upgradeModal" class="upgrade-modal" onclick="Upgrade.close()" style="display: none;">
  <div class="upgrade-content" onclick="event.stopPropagation()">
    <button class="close-btn" onclick="Upgrade.close()">×</button>
    
    <div class="upgrade-header">
      <span class="upgrade-icon">⚡</span>
      <h2>Upgrade EventGlimpse</h2>
      <p class="upgrade-subtitle">Choose the plan that fits your needs</p>
    </div>
    
    <div class="pricing-tiers">
      <% if (!isEventTier && !isPartyPackTier) { %>
      <!-- Event Tier - only show for free users -->
      <div class="pricing-card">
        <div class="tier-name"><%= eventTier.name || 'Event' %></div>
        <div class="tier-price">
          <span class="price-amount">$<%= eventTier.price || 5 %></span>
          <span class="price-label">one-time</span>
        </div>
        <ul class="tier-features">
          <li><span class="feature-icon">✓</span> <%= formatGalleries(eventTier.maxGalleries) %> galleries</li>
          <li><span class="feature-icon">✓</span> <%= (eventTier.maxPhotosPerGallery || 2000).toLocaleString() %> photos each</li>
          <li><span class="feature-icon">✓</span> <%= formatRetention(eventTier.retentionDays) %> retention</li>
        </ul>
        <button class="tier-btn" onclick="Upgrade.startCheckout('event')">
          Choose Event
        </button>
      </div>
      <% } %>
      
      <% if (!isPartyPackTier) { %>
      <!-- Party Pack - show for free and event users -->
      <div class="pricing-card popular">
        <div class="popular-badge">Best Value</div>
        <div class="tier-name"><%= partyTier.name || 'Party Pack' %></div>
        <div class="tier-price">
          <span class="price-amount">$<%= partyTier.price || 12 %></span>
          <span class="price-label">one-time</span>
        </div>
        <ul class="tier-features">
          <li><span class="feature-icon">✓</span> <%= formatGalleries(partyTier.maxGalleries) %> galleries</li>
          <li><span class="feature-icon">✓</span> <%= (partyTier.maxPhotosPerGallery || 2000).toLocaleString() %> photos each</li>
          <li><span class="feature-icon">✓</span> <%= formatRetention(partyTier.retentionDays) %> retention</li>
        </ul>
        <button class="tier-btn primary" onclick="Upgrade.startCheckout('partypack')">
          <%= isEventTier ? 'Upgrade to Party Pack' : 'Choose Party Pack' %>
        </button>
      </div>
      <% } else { %>
      <!-- Already on max tier -->
      <div class="pricing-card">
        <div class="tier-name">Party Pack</div>
        <div class="tier-price">
          <span class="price-label">Current Plan</span>
        </div>
        <p style="text-align: center; color: var(--muted-color);">You're on the highest tier. Need more galleries? Contact support.</p>
      </div>
      <% } %>
    </div>
    
    <p class="upgrade-guarantee">✓ Instant access • Secure payment via Stripe</p>
  </div>
</div>
