<%# Upgrade Modal Partial - pass type ('gallery-limit' or 'zip-download') and limits from GalleryService.getAllLimits() %>
<%
  const STRIPE_EVENT_LINK = process.env.STRIPE_EVENT_TIER_LINK || 'https://buy.stripe.com/test_fZueVd7J13SIf9i3KS8k800';
  const STRIPE_PARTY_LINK = process.env.STRIPE_PARTY_PACK_LINK || 'https://buy.stripe.com/test_4gM8wP2oH9d20eoepw8k801';
  const userEmail = user?.email || '';
%>
<div id="upgradeModal" class="upgrade-modal" data-user-email="<%= userEmail %>" onclick="Upgrade.close()" style="display: none;">
  <div class="upgrade-content" onclick="event.stopPropagation()">
    <button class="close-btn" onclick="Upgrade.close()">×</button>
    
    <div class="upgrade-header">
      <span class="upgrade-icon">⚡</span>
      <h2>Upgrade EventGlimpse</h2>
      <p class="upgrade-subtitle">Choose the plan that fits your needs</p>
    </div>
    
    <div class="pricing-tiers">
      <!-- Event Tier -->
      <div class="pricing-card">
        <div class="tier-name">Event Tier</div>
        <div class="tier-price">
          <span class="price-amount">$5</span>
          <span class="price-label">one-time</span>
        </div>
        <ul class="tier-features">
          <li><span class="feature-icon">✓</span> 2 galleries</li>
          <li><span class="feature-icon">✓</span> 500 photos each</li>
          <li><span class="feature-icon">✓</span> 90 days retention</li>
          <li><span class="feature-icon">✓</span> ZIP downloads</li>
        </ul>
        <button class="tier-btn" data-stripe-event="<%= STRIPE_EVENT_LINK %>" onclick="Upgrade.startCheckout('event')">
          Choose Event
        </button>
      </div>
      
      <!-- Party Pack -->
      <div class="pricing-card popular">
        <div class="popular-badge">Best Value</div>
        <div class="tier-name">Party Pack</div>
        <div class="tier-price">
          <span class="price-amount">$12</span>
          <span class="price-label">one-time</span>
        </div>
        <ul class="tier-features">
          <li><span class="feature-icon">✓</span> 5 galleries</li>
          <li><span class="feature-icon">✓</span> 500 photos each</li>
          <li><span class="feature-icon">✓</span> 90 days retention</li>
          <li><span class="feature-icon">✓</span> ZIP downloads</li>
        </ul>
        <button class="tier-btn primary" data-stripe-party="<%= STRIPE_PARTY_LINK %>" onclick="Upgrade.startCheckout('party')">
          Choose Party Pack
        </button>
      </div>
    </div>
    
    <p class="upgrade-guarantee">✓ Instant access • Secure payment via Stripe</p>
  </div>
</div>
