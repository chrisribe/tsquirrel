<%
  const { stories } = pageData;

  function timeAgo(date) {
    const now = new Date();
    const diff = Math.floor((now - new Date(date)) / 1000);
    if (diff < 60) return `${diff}s ago`;
    if (diff < 3600) return `${Math.floor(diff/60)}m ago`;
    if (diff < 86400) return `${Math.floor(diff/3600)}h ago`;
    return `${Math.floor(diff/86400)}d ago`;
  }

  function imageKey(url) {
    const raw = String(url || '').trim();
    if (!raw) return '';
    return raw.replace(/[?#].*$/, '').toLowerCase();
  }

  function pickThumb(story, seenSet) {
    const candidates = [story.image_url, ...(Array.isArray(story.source_images) ? story.source_images : [])];
    for (const src of candidates) {
      const key = imageKey(src);
      if (!key) continue;
      if (seenSet.has(key)) continue;
      seenSet.add(key);
      return { src, key, usedFallback: false };
    }
    return { src: '', key: '', usedFallback: true };
  }

  const seenImageKeys = new Set();
%>
<% stories.forEach((story, idx) => { %>
<% const meta = catMeta(story.category); %>
<% const recentHrs = (Date.now() - new Date(story.published_at || story.updated_at || story.created_at)) / 3600000; %>
<% const isBlowingUp = story.heat_score >= 30 && recentHrs <= 3; %>
<% const showTake = !!String(story.squirrel_take || '').trim(); %>
<% const thumb = pickThumb(story, seenImageKeys); %>
<% const showImageThumb = !!thumb.src; %>
<article class="story-card">
  <a href="/story/<%= story.slug %>" class="story-link" data-ga-event="story_open" data-ga-story-id="<%= story.id %>" data-ga-story-slug="<%= story.slug %>" data-ga-category="<%= story.category %>" data-ga-location="feed_card">
    <div class="card-inner">
      <div class="card-body">
        <div class="story-meta">
          <span class="badge <%= meta.badge %>"><%= catLabel(story.category) %></span>
          <% if (isBlowingUp) { %><span class="badge badge-hot">🔥 blowing up</span>
          <% } else if (story.heat_score >= 30) { %><span class="badge badge-hot">🔥 hot</span><% } %>
          <% if (story.source_count > 1) { %>
            <span class="badge badge-sources"><%= story.source_count %> sources</span>
          <% } %>
          <% if (story.image_url && thumb.usedFallback) { %>
            <span class="badge badge-update">↻ update</span>
          <% } %>
        </div>

        <h2 class="story-title"><%= story.title %></h2>

        <% if (story.summary) { %>
          <p class="story-summary"><%= story.summary %></p>
        <% } %>

        <% if (showTake) { %>
          <p class="card-take-note">🐿️ <%= story.squirrel_take %></p>
        <% } %>

        <div class="story-footer">
          <% if (story.tags && story.tags.length) { %>
            <div class="story-tags">
              <% story.tags.slice(0,4).forEach(tag => { %>
                <span class="story-tag" data-ga-event="tag_select" data-ga-tag="<%= tag %>" data-ga-location="feed_card" onclick="event.preventDefault(); event.stopPropagation(); location.href='/?tag=<%= encodeURIComponent(tag) %>'"><%= '#' + tag %></span>
              <% }); %>
            </div>
          <% } %>
          <span class="story-time"><%= timeAgo(story.updated_at || story.created_at) %></span>
        </div>
      </div>
      <div class="thumb <%= meta.cls %>">
        <% if (showImageThumb) { %>
          <img src="<%= secureUrl(thumb.src) %>" alt="" <%= idx === 0 ? "loading=\"eager\" fetchpriority=\"high\"" : "loading=\"lazy\"" %> decoding="async" referrerpolicy="no-referrer" onerror="this.style.display='none';this.nextElementSibling.style.display='flex'">
          <span class="thumb-fallback" style="display:none"><%= meta.thumb %></span>
        <% } else { %>
          <%= meta.thumb %>
        <% } %>
      </div>
    </div>
  </a>
</article>
<% }); %>
<% if (!stories.length) { %>
  <p style="text-align:center;padding:2rem;color:var(--pico-muted-color)">No stories yet — check back soon.</p>
<% } %>
