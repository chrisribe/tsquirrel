<%
  const { stories } = pageData;
  const adEnabled = Boolean(showHomeAdCard && googleAdsenseClient && googleAdsenseHomeFeedSlot);

  function timeAgo(date) {
    const now = new Date();
    const diff = Math.floor((now - new Date(date)) / 1000);
    if (diff < 60) return `${diff}s ago`;
    if (diff < 3600) return `${Math.floor(diff/60)}m ago`;
    if (diff < 86400) return `${Math.floor(diff/3600)}h ago`;
    return `${Math.floor(diff/86400)}d ago`;
  }

  function imageKey(url) {
    const raw = String(url || '').trim();
    if (!raw) return '';
    return raw.replace(/[?#].*$/, '').toLowerCase();
  }

  function chooseStoryImage(story, seenSet) {
    const original = String(story.image_url || '').trim();
    const candidates = [original, ...(Array.isArray(story.source_images) ? story.source_images : [])];
    for (const src of candidates) {
      const key = imageKey(src);
      if (!key) continue;
      if (seenSet.has(key)) continue;
      seenSet.add(key);
      if (src !== original) story.image_url = src; // KISS: switch story image to alt for this feed render
      return { hasImage: true };
    }
    return { hasImage: false };
  }

  const seenImageKeys = new Set();
%>
<% stories.forEach((story, idx) => { %>
<% if (adEnabled && idx === 8) { %>
<article class="story-card ad-card" aria-label="Sponsored content">
  <div class="card-inner">
    <div class="card-body ad-card-body">
      <div class="story-meta">
        <span class="badge badge-sources ad-badge">Sponsored</span>
      </div>
      <div class="ad-slot-shell">
        <ins class="adsbygoogle"
             style="display:block"
             data-ad-client="<%= googleAdsenseClient %>"
             data-ad-slot="<%= googleAdsenseHomeFeedSlot %>"
             data-ad-format="rectangle"
             data-full-width-responsive="true"></ins>
      </div>
    </div>
  </div>
</article>
<script>
  (adsbygoogle = window.adsbygoogle || []).push({});
  (function syncSponsoredCardHeight(){
    const adCard = document.querySelector('.story-feed > .story-card.ad-card');
    if (!adCard) return;

    function rowCards() {
      const cards = [...document.querySelectorAll('.story-feed > .story-card')];
      const top = adCard.getBoundingClientRect().top;
      return cards.filter(c => Math.abs(c.getBoundingClientRect().top - top) < 2);
    }

    function apply() {
      adCard.style.height = '';
      if (window.matchMedia('(max-width: 759px)').matches) return;
      const row = rowCards();
      if (!row.length) return;
      const maxH = Math.max(...row.map(c => c.getBoundingClientRect().height));
      if (Number.isFinite(maxH) && maxH > 0) adCard.style.height = `${Math.round(maxH)}px`;
    }

    const runLater = () => requestAnimationFrame(apply);
    apply();
    runLater();
    setTimeout(apply, 180);
    setTimeout(apply, 700);
    window.addEventListener('load', apply, { once: true });
    window.addEventListener('resize', runLater, { passive: true });

    if ('ResizeObserver' in window) {
      const ro = new ResizeObserver(runLater);
      rowCards().forEach(c => ro.observe(c));
    }
  })();
</script>
<% } %>
<% const meta = catMeta(story.category); %>
<% const recentHrs = (Date.now() - new Date(story.published_at || story.updated_at || story.created_at)) / 3600000; %>
<% const isBlowingUp = story.heat_score >= 30 && recentHrs <= 3; %>
<% const showTake = !!String(story.squirrel_take || '').trim(); %>
<% const originalImageUrl = String(story.image_url || '').trim(); %>
<% const imageChoice = chooseStoryImage(story, seenImageKeys); %>
<% const showImageThumb = imageChoice.hasImage; %>
<article class="story-card">
  <a href="/story/<%= story.slug %>" class="story-link" data-ga-event="story_open" data-ga-story-id="<%= story.id %>" data-ga-story-slug="<%= story.slug %>" data-ga-category="<%= story.category %>" data-ga-location="feed_card">
    <div class="card-inner">
      <div class="card-body">
        <div class="story-meta">
          <span class="badge <%= meta.badge %>"><%= catLabel(story.category) %></span>
          <% if (isBlowingUp) { %><span class="badge badge-hot">🔥 blowing up</span>
          <% } else if (story.heat_score >= 30) { %><span class="badge badge-hot">🔥 hot</span><% } %>
          <% if (story.source_count > 1) { %>
            <span class="badge badge-sources"><%= story.source_count %> sources</span>
          <% } %>
          <% if (originalImageUrl && !showImageThumb) { %>
            <span class="badge badge-update">↻ update</span>
          <% } %>
        </div>

        <h2 class="story-title"><%= story.title %></h2>

        <% if (story.summary) { %>
          <p class="story-summary"><%= story.summary %></p>
        <% } %>

        <% if (showTake) { %>
          <p class="card-take-note">🐿️ <%= story.squirrel_take %></p>
        <% } %>

        <div class="story-footer">
          <% if (story.tags && story.tags.length) { %>
            <div class="story-tags">
              <% story.tags.slice(0,4).forEach(tag => { %>
                <span class="story-tag" data-ga-event="tag_select" data-ga-tag="<%= tag %>" data-ga-location="feed_card" onclick="event.preventDefault(); event.stopPropagation(); location.href='/?tag=<%= encodeURIComponent(tag) %>'"><%= '#' + tag %></span>
              <% }); %>
            </div>
          <% } %>
          <span class="story-time"><%= timeAgo(story.updated_at || story.created_at) %></span>
        </div>
      </div>
      <div class="thumb <%= meta.cls %>">
        <% if (showImageThumb) { %>
          <img src="<%= secureUrl(story.image_url) %>" alt="" <%= idx === 0 ? "loading=\"eager\" fetchpriority=\"high\"" : "loading=\"lazy\"" %> decoding="async" referrerpolicy="no-referrer" onerror="this.style.display='none';this.nextElementSibling.style.display='flex'">
          <span class="thumb-fallback" style="display:none"><%= meta.thumb %></span>
        <% } else { %>
          <%= meta.thumb %>
        <% } %>
      </div>
    </div>
  </a>
</article>
<% }); %>
<% if (!stories.length) { %>
  <p style="text-align:center;padding:2rem;color:var(--pico-muted-color)">No stories yet — check back soon.</p>
<% } %>
