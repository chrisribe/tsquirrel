<%
  const { stories } = pageData;
  function timeAgo(date) {
    const now = new Date();
    const diff = Math.floor((now - new Date(date)) / 1000);
    if (diff < 60) return `${diff}s ago`;
    if (diff < 3600) return `${Math.floor(diff/60)}m ago`;
    if (diff < 86400) return `${Math.floor(diff/3600)}h ago`;
    return `${Math.floor(diff/86400)}d ago`;
  }
%>
<% stories.forEach(story => { %>
<% const meta = catMeta(story.category); %>
<article class="story-card">
  <a href="/story/<%= story.slug %>" class="story-link">
    <div class="card-inner">
      <div class="card-body">
        <div class="story-meta">
          <span class="badge <%= meta.badge %>"><%= catLabel(story.category) %></span>
          <% if (story.heat_score >= 30) { %><span class="badge badge-hot">🔥 hot</span><% } %>
          <% if (story.source_count > 1) { %>
            <span class="badge badge-sources"><%= story.source_count %> sources</span>
          <% } %>
          <span class="story-time"><%= timeAgo(story.updated_at || story.created_at) %></span>
        </div>
        <h2 class="story-title"><%= story.title %></h2>
        <% if (story.squirrel_take) { %>
          <p class="card-editorial">🐿️ <%= story.squirrel_take %></p>
        <% } else if (story.summary) { %>
          <p class="story-summary"><%= story.summary %></p>
        <% } %>
        <% if (story.tags && story.tags.length) { %>
          <div class="story-tags">
            <% story.tags.slice(0,4).forEach(tag => { %>
              <span class="story-tag">#<%= tag %></span>
            <% }); %>
          </div>
        <% } %>
      </div>
      <div class="thumb <%= meta.cls %>">
        <% if (story.image_url) { %>
          <img src="<%= story.image_url %>" alt="" loading="lazy" referrerpolicy="no-referrer" onerror="this.style.display='none';this.nextElementSibling.style.display='flex'">
          <span class="thumb-fallback" style="display:none"><%= meta.thumb %></span>
        <% } else { %>
          <%= meta.thumb %>
        <% } %>
      </div>
    </div>
  </a>
</article>
<% }); %>
<% if (!stories.length) { %>
  <p style="text-align:center;padding:2rem;color:var(--pico-muted-color)">No stories yet — check back soon.</p>
<% } %>
