<% const {events, upcomingEvents, pastEvents, eventCounts} = pageData %>

<div class="events-container">
  <hgroup>
    <h2>Planned events</h2>
    <p>Keep your friends close and the memories closer</p>
  </hgroup>

  <!-- Dashboard header with actions -->
  <div class="dashboard-header">
    <div class="event-stats">
      <% if (eventCounts && eventCounts.total > 0) { %>
        <span class="event-count">
          You have <%= eventCounts.total %> event<%= eventCounts.total !== 1 ? 's' : '' %>
          <% if (eventCounts.upcoming > 0) { %>
            (<%= eventCounts.upcoming %> upcoming)
          <% } %>
        </span>
      <% } %>
    </div>
    <div class="header-actions">
      <button type="button" 
              class="primary-button create-event-btn" 
              data-open-modal="addEventModal">
        Create New Event
      </button>
    </div>
  </div>

  <!-- Search box for our next feature -->
  <div class="search-container">
    <input type="search" 
      placeholder="Search events, tags, categories..." 
      name="q"
      hx-get="/events/search" 
      hx-trigger="keyup changed delay:500ms" 
      hx-target="#events-list"
      hx-indicator=".search-spinner">
     <div class="search-spinner htmx-indicator"></div>
  </div>

  <div id="events-list">
    <%- include('events/events-list', {events: events, upcomingEvents: upcomingEvents, pastEvents: pastEvents, eventCounts: eventCounts}) %>
  </div>
  
</div>

<!-- Modal for adding new event -->
<dialog id="addEventModal">
  <article>
    <a href="#" onclick="document.getElementById('addEventModal').close(); return false;" aria-label="Close" class="close"></a>
    <h2>Add New Event</h2>
    <form id="addEventForm" 
      hx-post="/events" 
      hx-target="#events-list"
      hx-swap="innerHTML"
      hx-on::after-request="if(event.detail.successful) { this.reset(); document.getElementById('addEventModal').close(); }"
    >

      <%- include('events/event-form-add', {pageData: pageData}) %>

    </form>

  </article>
</dialog>

<!-- Modal for editing existing event -->
<dialog id="editEventModal">
  <article>
    <a href="#" onclick="document.getElementById('editEventModal').close(); return false;" aria-label="Close" class="close"></a>
    <div class="modal-content">
      <!-- Content will be loaded via HTMX -->
    </div>
  </article>
</dialog>
 