<% const {events} = pageData %>

<link rel="stylesheet" href="/static/css/events.css">
<div class="events-container">
  <hgroup>
    <h2>Planned events</h2>
    <p>Keep your friends close and the memories closer</p>
  </hgroup>

  <div id="addEventButton" class="fab" onclick="openAddEventModal()"></div>

  <% if (events && events.length > 0) { %>
    <ul>
      <% events.forEach(event => { %>
        <li>
          <figure>
            <img src="<%= event.event_picture %>" alt="Event Picture">
          </figure>
          <div>
            <hgroup>
              <h2><%= event.title %></h2>
              <p><%= event.description %></p>
            </hgroup>
            <table class="striped">
              <tbody>
                <tr>
                  <th>When ?</th>
                  <td>
                    <%= new Date(event.date).toLocaleString('en-US', {
                      weekday: 'long',
                      year: 'numeric',
                      month: 'long',
                      day: 'numeric',
                      hour: 'numeric',
                      minute: 'numeric',
                      hour12: true
                    }) %>
                  </td>
                </tr>
                <tr>
                  <th>Location</th>
                  <td><%= event.location %></td>
                </tr>
                <tr>
                  <th>Status</th>
                  <td><%= event.status %></td>
                </tr>
              </tbody>

            </table>
          </div>

        </li>
      <% }) %>
    </ul>
  <% } else { %>
    <p>No events available.</p>
  <% } %>
</div>

<!-- Modal for adding new event -->
<dialog id="addEventModal">
  <article>
    <a href="#close" aria-label="Close" class="close" data-target="addEventModal"></a>
    <h2>Add New Event</h2>
    <form id="addEventForm" method="post" action="/api/events">
      <label for="title">Title</label>
      <input type="text" id="title" name="title" required>

      <label for="description">Description</label>
      <textarea id="description" name="description" required></textarea>

      <label for="date">Date</label>
      <input type="datetime-local" id="date" name="date" required>

      <label for="location">Location</label>
      <input type="text" id="location" name="location" required>

      <label for="status">Status</label>
      <input type="text" id="status" name="status" required>

      <label for="event_picture">Event Picture URL</label>
      <input type="url" id="event_picture" name="event_picture" required>

      <button type="submit" class="button primary">Add Event</button>
    </form>
  </article>
</dialog>

<script>
  document.getElementById('addEventButton').addEventListener('click', function() {
    document.getElementById('addEventModal').showModal();
  });

  document.querySelectorAll('.close').forEach(function(closeButton) {
    closeButton.addEventListener('click', function(event) {
      event.preventDefault();
      document.getElementById(closeButton.getAttribute('data-target')).close();
    });
  });

  function openAddEventModal() {
    document.getElementById('addEventModal').showModal();
  }
</script>