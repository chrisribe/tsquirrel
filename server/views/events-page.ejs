<% const {events} = pageData %>

<link rel="stylesheet" href="/static/css/events.css">
<div class="events-container">
  <hgroup>
    <h2>Planned events</h2>
    <p>Keep your friends close and the memories closer</p>
  </hgroup>

  <!-- Search box for our next feature -->
  <div class="search-container">
    <input type="search" 
      placeholder="Search events..." 
      name="q"
      hx-get="/events/search" 
      hx-trigger="keyup changed delay:500ms" 
      hx-target="#events-list"
      hx-indicator=".search-spinner">
     <div class="search-spinner htmx-indicator"></div>
  </div>

  <div id="events-list">
    <%- include('events/events-list', {events: events}) %>
  </div>

  <div class="addNewEvent fab" data-open-modal="addEventModal"></div>
  
</div>

<!-- Modal for adding new event -->
<dialog id="addEventModal">
  <article>
    <a href="#close" aria-label="Close" class="close"></a>
    <h2>Add New Event</h2>
    <form id="addEventForm" 
      hx-post="/events" 
      hx-target="#events-list"
      hx-on::after-request="this.closest('dialog').close()"
      >
      <label for="title">Title</label>
      <input type="text" id="title" name="title" required>

      <label for="description">Description</label>
      <textarea id="description" name="description"></textarea>

      <label for="date">Date</label>
      <!-- default to today -->
      <script>
        const today = new Date();
        const formattedDate = today.toISOString().substring(0, 16);
        document.addEventListener('DOMContentLoaded', function() {
          document.getElementById('date').value = formattedDate;
        });
      </script>
      <input type="datetime-local" id="date" name="date" >

      <label for="location">Location</label>
      <input type="text" id="location" name="location">

      <button type="submit" class="button primary">Add Event</button>
    </form>
  </article>
</dialog>
 