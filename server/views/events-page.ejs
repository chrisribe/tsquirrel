<% const {events} = pageData %>

<link rel="stylesheet" href="/static/css/events.css">
<div class="events-container">
  <hgroup>
    <h2>Planned events</h2>
    <p>Keep your friends close and the memories closer</p>
  </hgroup>

  <!-- Search box for our next feature -->
  <div class="search-container">
    <input type="search" 
      placeholder="Search events..." 
      name="q"
      hx-get="/events/search" 
      hx-trigger="keyup changed delay:500ms" 
      hx-target="#events-list"
      hx-indicator=".search-spinner">
     <div class="search-spinner htmx-indicator"></div>
  </div>

  <div id="events-list">
    <%- include('events/events-list', {events: events}) %>
  </div>

  <div class="addNewEvent fab" data-open-modal="addEventModal"></div>
  
</div>

<!-- Modal for adding new event -->
<dialog id="addEventModal">
  <article>
    <a href="#close" aria-label="Close" class="close"></a>
    <h2>Add New Event</h2>
    <form id="addEventForm" 
      hx-post="/events" 
      hx-target="#events-list ul"
      hx-swap="afterbegin"
    >

      <%- include('events/event-form-add', {pageData: pageData}) %>

    </form>
    <script>
      // Handle successful submission
      document.getElementById('addEventForm').addEventListener('htmx:afterOnLoad', function(evt) {
        if (evt.detail.successful) {
          this.reset();
          this.closest('dialog').close();
        }
      });
      document.getElementById('addEventForm').addEventListener('htmx:error', function(evt) {
        document.getElementById('addEventForm').innerHTML = evt.detail.errorInfo.xhr.responseText || 
        '<div class="error">Network error. Please try again.</div>';
      });
    </script>

  </article>
</dialog>
 