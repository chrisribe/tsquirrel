<section>
  <h1>Galleries for <%= pageData.user.username %></h1>
  <p><a href="/admin">← Back to Admin Dashboard</a></p>
  
  <% if (pageData.galleries && pageData.galleries.length > 0) { %>
    <div class="admin-table-desktop">
      <table>
        <thead>
          <tr>
            <th>ID</th>
            <th>Title</th>
            <th>Photos</th>
            <th>Created</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% pageData.galleries.forEach(g => { %>
            <tr>
              <td><%= g.id %></td>
              <td><%= g.title %></td>
              <td><%= g.photo_count %></td>
              <td><%= new Date(g.created_at).toLocaleDateString() %></td>
              <td>
                <a href="/g/<%= g.uuid %>" target="_blank" class="outline">View Gallery</a>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
    
    <!-- Mobile cards -->
    <div class="admin-cards-mobile">
      <% pageData.galleries.forEach(g => { %>
        <div class="user-card">
          <div class="user-card-header">
            <strong><%= g.title %></strong>
          </div>
          <div class="user-card-details">
            <small><%= g.photo_count %> photos • Created <%= new Date(g.created_at).toLocaleDateString() %></small>
          </div>
          <div class="user-card-actions">
            <a href="/g/<%= g.uuid %>" target="_blank" class="outline">View Gallery</a>
          </div>
        </div>
      <% }); %>
    </div>
  <% } else { %>
    <p>No galleries found for this user.</p>
  <% } %>
</section>
