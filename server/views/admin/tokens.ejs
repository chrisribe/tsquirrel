<section class="admin-tokens">
  <a href="/admin" class="admin-back">&larr; Back to Admin Dashboard</a>
  <h1>API Tokens</h1>
  <p class="admin-meta">Create revocable tokens for future API clients. Token secret is shown once at creation.</p>

  <% if (pageData.message) { %>
    <article class="admin-alert is-success">
      <strong><%= pageData.message %></strong>
      <% if (pageData.createdToken) { %>
        <code><%= pageData.createdToken %></code>
      <% } %>
    </article>
  <% } %>

  <% if (pageData.error) { %>
    <article class="admin-alert is-error">
      <strong><%= pageData.error %></strong>
    </article>
  <% } %>

  <form method="POST" action="/admin/tokens" class="admin-inline-form">
    <label for="token-label">Token label</label>
    <input id="token-label" name="label" type="text" maxlength="100" required placeholder="e.g. Hermes Curator Bot">
    <button type="submit">Create token</button>
  </form>

  <div class="table-scroll">
    <table>
      <thead>
        <tr>
          <th>Label</th>
          <th class="nowrap">Prefix</th>
          <th class="nowrap">Created</th>
          <th class="nowrap">Last used</th>
          <th class="nowrap">Status</th>
          <th>Action</th>
        </tr>
      </thead>
      <tbody>
        <% if (!pageData.tokens.length) { %>
          <tr><td colspan="6" class="hint">No tokens yet.</td></tr>
        <% } %>
        <% pageData.tokens.forEach(function(t) { %>
          <tr>
            <td><%= t.label %></td>
            <td class="nowrap mono">tsq_••••</td>
            <td class="nowrap mono"><%= new Date(t.created_at).toLocaleString() %></td>
            <td class="nowrap mono"><%= t.last_used_at ? new Date(t.last_used_at).toLocaleString() : 'never' %></td>
            <td class="nowrap">
              <span class="status-pill <%= t.revoked_at ? 'is-revoked' : 'is-active' %>"><%= t.revoked_at ? 'revoked' : 'active' %></span>
            </td>
            <td>
              <% if (!t.revoked_at) { %>
                <form method="POST" action="/admin/tokens/<%= t.id %>/revoke">
                  <button type="submit" class="outline secondary">Revoke</button>
                </form>
              <% } else { %>
                <span class="hint">revoked <%= new Date(t.revoked_at).toLocaleString() %></span>
              <% } %>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
</section>
