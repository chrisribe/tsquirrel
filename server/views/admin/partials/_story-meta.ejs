<p id="story-meta" class="admin-meta"<%= pageData.oob ? ' hx-swap-oob="outerHTML"' : '' %>>
  Status:
  <span class="status-pill is-<%= pageData.story.status %>">
    <% if (pageData.story.status === 'published') { %>Published
    <% } else if (pageData.story.status === 'draft') { %>Draft
    <% } else { %>Hidden<% } %>
  </span>
  · Heat: <%= pageData.story.heat_score %> · Sources: <%= pageData.story.source_count %>
  <% if (pageData.story.is_featured) { %> · Featured<% } %>
</p>
<% if (pageData.story.needs_review) { %>
  <p id="story-review-banner" class="admin-review-banner"<%= pageData.oob ? ' hx-swap-oob="outerHTML"' : '' %>>
    🔄 Radar found possible follow-up source(s) for this story — review the suggestions below and accept or reject each one.
  </p>
<% } else { %>
  <p id="story-review-banner" class="admin-review-banner is-hidden"<%= pageData.oob ? ' hx-swap-oob="outerHTML"' : '' %>></p>
<% } %>
