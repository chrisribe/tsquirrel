<%
  const returnTo = pageData.returnTo || '/admin/stories';
  const statusParam = pageData.activeStatus ? `status=${encodeURIComponent(pageData.activeStatus)}` : '';
  const pageHref = (page) => {
    const parts = [];
    if (statusParam) parts.push(statusParam);
    if (page > 1) parts.push(`page=${page}`);
    return `/admin/stories${parts.length ? '?' + parts.join('&') : ''}`;
  };
%>
<section class="admin-stories">
  <a href="/admin" class="admin-back">&larr; Back to Admin Dashboard</a>
  <div class="admin-toolbar">
    <h1>Stories</h1>
    <a href="/admin/stories/new" role="button">+ New Story</a>
  </div>

  <div class="admin-tabs">
    <a href="/admin/stories" class="admin-tab <%= !pageData.activeStatus ? 'active' : '' %>">All</a>
    <a href="/admin/stories?status=draft" class="admin-tab <%= pageData.activeStatus === 'draft' ? 'active' : '' %>">Drafts</a>
    <a href="/admin/stories?status=published" class="admin-tab <%= pageData.activeStatus === 'published' ? 'active' : '' %>">Published</a>
    <a href="/admin/stories?status=hidden" class="admin-tab <%= pageData.activeStatus === 'hidden' ? 'active' : '' %>">Hidden</a>
  </div>

  <% if (pageData.stories.length === 0) { %>
    <p class="hint">No stories<%= pageData.activeStatus ? ' with status ' + pageData.activeStatus : '' %> yet.</p>
  <% } else { %>
    <form id="bulk-stories-form" method="POST" action="/admin/stories/bulk" class="admin-actions" style="margin: 12px 0; gap: 8px; align-items: center;">
      <input type="hidden" name="returnTo" value="<%= returnTo %>">
      <label class="nowrap" for="bulk-action-select" style="margin:0">Bulk action</label>
      <select id="bulk-action-select" name="action" required>
        <option value="">Choose…</option>
        <option value="publish">Publish</option>
        <option value="unpublish">Unpublish (to draft)</option>
        <option value="hide">Hide</option>
        <option value="feature">Feature</option>
        <option value="unfeature">Unfeature</option>
        <option value="delete">Delete permanently</option>
      </select>
      <button type="submit" class="outline" id="bulk-apply-btn" disabled>Apply to selected</button>
      <span class="hint" id="bulk-selected-count">0 selected</span>
    </form>

    <div class="table-scroll">
    <table>
      <thead>
        <tr>
          <th class="nowrap"><input type="checkbox" id="stories-select-all" aria-label="Select all stories on this page"></th>
          <th></th>
          <th>Title</th>
          <th class="nowrap">Status</th>
          <th class="nowrap">Category</th>
          <th class="nowrap">Sources</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% pageData.stories.forEach(function(s) { %>
          <tr>
            <td class="nowrap">
              <input type="checkbox" name="storyIds" value="<%= s.id %>" form="bulk-stories-form" class="story-select-box" aria-label="Select story <%= s.title %>">
            </td>
            <td>
              <% if (s.image_url) { %>
                <img src="<%= s.image_url %>" alt="" loading="lazy" width="40" referrerpolicy="no-referrer" style="border-radius:4px;display:block">
              <% } %>
            </td>
            <td class="story-title-cell">
              <a href="/admin/stories/<%= s.id %>/edit?returnTo=<%= encodeURIComponent(returnTo) %>"><%= s.title %></a>
              <% if (s.is_featured) { %><span class="story-flag">Featured</span><% } %>
              <% if (s.pending_suggestions > 0) { %><span class="story-flag story-flag-review">🔄 <%= s.pending_suggestions %> to review</span><% } %>
            </td>
            <td class="nowrap">
              <% if (s.status === 'published') { %>
                <a class="status-pill is-published" href="/story/<%= s.slug %>" target="_blank" rel="noopener">Published</a>
              <% } else if (s.status === 'draft') { %>
                <span class="status-pill is-draft">Draft</span>
              <% } else { %>
                <span class="status-pill is-hidden">Hidden</span>
              <% } %>
            </td>
            <td class="nowrap"><%= s.category || 'News' %></td>
            <td class="nowrap mono"><%= s.source_count %></td>
            <td>
              <div class="admin-actions">
                <% if (s.status !== 'published') { %>
                  <form method="POST" action="/admin/stories/<%= s.id %>/publish">
                    <input type="hidden" name="returnTo" value="<%= returnTo %>">
                    <button type="submit" class="outline">Publish</button>
                  </form>
                <% } else { %>
                  <form method="POST" action="/admin/stories/<%= s.id %>/unpublish">
                    <input type="hidden" name="returnTo" value="<%= returnTo %>">
                    <button type="submit" class="outline secondary">Unpublish</button>
                  </form>
                <% } %>
                <form method="POST" action="/admin/stories/<%= s.id %>/feature">
                  <input type="hidden" name="featured" value="<%= s.is_featured ? 'false' : 'true' %>">
                  <input type="hidden" name="returnTo" value="<%= returnTo %>">
                  <button type="submit" class="outline"><%= s.is_featured ? 'Unfeature' : 'Feature' %></button>
                </form>
              </div>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
    </div>

    <% if (pageData.pagination && pageData.pagination.totalPages > 1) { %>
      <nav class="admin-pager" aria-label="Story list pages">
        <% if (pageData.pagination.hasPrev) { %>
          <a href="<%= pageHref(pageData.pagination.page - 1) %>" role="button" class="outline">← Prev</a>
        <% } else { %>
          <span class="outline" aria-disabled="true">← Prev</span>
        <% } %>
        <span class="hint">Page <strong><%= pageData.pagination.page %></strong> of <strong><%= pageData.pagination.totalPages %></strong> (<%= pageData.pagination.total %> stories)</span>
        <% if (pageData.pagination.hasNext) { %>
          <a href="<%= pageHref(pageData.pagination.page + 1) %>" role="button" class="outline">Next →</a>
        <% } else { %>
          <span class="outline" aria-disabled="true">Next →</span>
        <% } %>
      </nav>
    <% } %>

    <script>
      (() => {
        const form = document.getElementById('bulk-stories-form');
        if (!form) return;
        const selectAll = document.getElementById('stories-select-all');
        const checkboxes = Array.from(document.querySelectorAll('.story-select-box'));
        const actionSelect = document.getElementById('bulk-action-select');
        const applyBtn = document.getElementById('bulk-apply-btn');
        const countEl = document.getElementById('bulk-selected-count');

        const refresh = () => {
          const selected = checkboxes.filter((cb) => cb.checked).length;
          if (countEl) countEl.textContent = `${selected} selected`;
          if (applyBtn) applyBtn.disabled = selected === 0 || !actionSelect.value;
          if (selectAll) {
            selectAll.checked = selected > 0 && selected === checkboxes.length;
            selectAll.indeterminate = selected > 0 && selected < checkboxes.length;
          }
        };

        if (selectAll) {
          selectAll.addEventListener('change', () => {
            for (const cb of checkboxes) cb.checked = selectAll.checked;
            refresh();
          });
        }

        for (const cb of checkboxes) cb.addEventListener('change', refresh);
        actionSelect.addEventListener('change', refresh);

        form.addEventListener('submit', (event) => {
          if (actionSelect.value === 'delete') {
            const selected = checkboxes.filter((cb) => cb.checked).length;
            if (!window.confirm(`Delete ${selected} selected stor${selected === 1 ? 'y' : 'ies'} permanently?`)) {
              event.preventDefault();
            }
          }
        });

        refresh();
      })();
    </script>
  <% } %>
  <p class="hint">Stories are authored manually here (or via the API later). Nothing is live until <strong>Published</strong>. Existing auto-generated stories were set to <em>hidden</em> on migration — review and publish the good ones.</p>
</section>
