<section class="admin-stories">
  <a href="/admin" class="admin-back">&larr; Back to Admin Dashboard</a>
  <div class="admin-toolbar">
    <h1>Stories</h1>
    <a href="/admin/stories/new" role="button">+ New Story</a>
  </div>

  <div class="admin-tabs">
    <a href="/admin/stories" class="admin-tab <%= !pageData.activeStatus ? 'active' : '' %>">All</a>
    <a href="/admin/stories?status=draft" class="admin-tab <%= pageData.activeStatus === 'draft' ? 'active' : '' %>">Drafts</a>
    <a href="/admin/stories?status=published" class="admin-tab <%= pageData.activeStatus === 'published' ? 'active' : '' %>">Published</a>
    <a href="/admin/stories?status=hidden" class="admin-tab <%= pageData.activeStatus === 'hidden' ? 'active' : '' %>">Hidden</a>
  </div>

  <% if (pageData.stories.length === 0) { %>
    <p class="hint">No stories<%= pageData.activeStatus ? ' with status ' + pageData.activeStatus : '' %> yet.</p>
  <% } else { %>
    <div class="table-scroll">
    <table>
      <thead>
        <tr>
          <th></th>
          <th>Title</th>
          <th class="nowrap">Status</th>
          <th class="nowrap">Category</th>
          <th class="nowrap">Sources</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% pageData.stories.forEach(function(s) { %>
          <tr>
            <td>
              <% if (s.image_url) { %>
                <img src="<%= s.image_url %>" alt="" loading="lazy" width="40" referrerpolicy="no-referrer" style="border-radius:4px;display:block">
              <% } %>
            </td>
            <td class="story-title-cell">
              <a href="/admin/stories/<%= s.id %>/edit"><%= s.title %></a>
              <% if (s.is_featured) { %><span class="story-flag">Featured</span><% } %>
              <% if (s.pending_suggestions > 0) { %><span class="story-flag story-flag-review">🔄 <%= s.pending_suggestions %> to review</span><% } %>
            </td>
            <td class="nowrap">
              <% if (s.status === 'published') { %>
                <a class="status-pill is-published" href="/story/<%= s.slug %>" target="_blank" rel="noopener">Published</a>
              <% } else if (s.status === 'draft') { %>
                <span class="status-pill is-draft">Draft</span>
              <% } else { %>
                <span class="status-pill is-hidden">Hidden</span>
              <% } %>
            </td>
            <td class="nowrap"><%= s.category || 'News' %></td>
            <td class="nowrap mono"><%= s.source_count %></td>
            <td>
              <div class="admin-actions">
                <% if (s.status !== 'published') { %>
                  <form method="POST" action="/admin/stories/<%= s.id %>/publish">
                    <input type="hidden" name="returnTo" value="/admin/stories<%= pageData.activeStatus ? '?status=' + pageData.activeStatus : '' %>">
                    <button type="submit" class="outline">Publish</button>
                  </form>
                <% } else { %>
                  <form method="POST" action="/admin/stories/<%= s.id %>/unpublish">
                    <input type="hidden" name="returnTo" value="/admin/stories<%= pageData.activeStatus ? '?status=' + pageData.activeStatus : '' %>">
                    <button type="submit" class="outline secondary">Unpublish</button>
                  </form>
                <% } %>
                <form method="POST" action="/admin/stories/<%= s.id %>/feature">
                  <input type="hidden" name="featured" value="<%= s.is_featured ? 'false' : 'true' %>">
                  <input type="hidden" name="returnTo" value="/admin/stories<%= pageData.activeStatus ? '?status=' + pageData.activeStatus : '' %>">
                  <button type="submit" class="outline"><%= s.is_featured ? 'Unfeature' : 'Feature' %></button>
                </form>
              </div>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
    </div>
  <% } %>
  <p class="hint">Stories are authored manually here (or via the API later). Nothing is live until <strong>Published</strong>. Existing auto-generated stories were set to <em>hidden</em> on migration — review and publish the good ones.</p>
</section>
