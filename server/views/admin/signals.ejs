<section class="admin-signals">
  <a href="/admin" class="admin-back">&larr; Back to Admin Dashboard</a>
  <div class="admin-toolbar">
    <h1>Radar Signals</h1>
    <form method="POST" action="/admin/signals/scan">
      <button type="submit" class="outline">Run Radar Now</button>
    </form>
  </div>

  <div class="admin-tabs">
    <a href="/admin/signals" class="admin-tab <%= (!pageData.filter || pageData.filter === 'active') ? 'active' : '' %>">Active</a>
    <a href="/admin/signals?status=all" class="admin-tab <%= pageData.filter === 'all' ? 'active' : '' %>">All</a>
    <a href="/admin/signals?status=used" class="admin-tab <%= pageData.filter === 'used' ? 'active' : '' %>">Used</a>
    <a href="/admin/signals?status=dismissed" class="admin-tab <%= pageData.filter === 'dismissed' ? 'active' : '' %>">Dismissed</a>
  </div>

  <% if (pageData.signals.length === 0) { %>
    <p class="hint">No signals<%= pageData.filter ? ' matching filter' : '' %>. Radar detects cross-source convergence after each ingest cycle.</p>
  <% } else { %>
    <div class="signals-stack">
      <% pageData.signals.forEach(function(sig) {
        const evidence = typeof sig.evidence === 'string' ? JSON.parse(sig.evidence) : (sig.evidence || {});
        const isExpired = sig.expires_at && new Date(sig.expires_at) < new Date();
        const articleIds = evidence.article_ids || [];
        const matchedArticles = pageData.articleMap ? articleIds.map(function(aid) { return pageData.articleMap[aid]; }).filter(Boolean) : [];
        const subjectParts = matchedArticles.slice(0, 3).map(function(art) {
          return (art.title || '').replace(/\s+/g, ' ').trim();
        }).filter(Boolean);
        const subjectApprox = subjectParts.length
          ? subjectParts.join(' | ').slice(0, 140)
          : `Coverage across ${(evidence.sources || []).length} sources and ${evidence.article_count || 0} articles`;
      %>
        <article class="signal-card <%= sig.status === 'dismissed' || isExpired ? 'admin-row-faded' : '' %>">
          <div class="signal-card-head">
            <p class="signal-topic"><%= sig.topic %></p>
            <div class="signal-head-badges">
              <span class="signal-strength">Strength <strong class="mono"><%= sig.strength %></strong></span>
              <span class="status-pill is-<%= sig.status %>">
                <% if (sig.status === 'new') { %>New
                <% } else if (sig.status === 'reviewed') { %>Reviewed
                <% } else if (sig.status === 'used') { %>Used
                <% } else { %>Dismissed<% } %>
              </span>
              <% if (isExpired && sig.status !== 'dismissed') { %>
                <span class="status-pill is-hidden">Expired</span>
              <% } %>
            </div>
          </div>

          <p class="signal-subject"><%= subjectApprox %><%= subjectParts.length && subjectParts.join(' | ').length > 140 ? '...' : '' %></p>

          <div class="signal-meta-row">
            <span class="signal-meta-chip"><strong class="mono"><%= evidence.article_count || 0 %></strong> articles</span>
            <span class="signal-meta-chip">detected <span class="mono"><%= new Date(sig.fired_at).toLocaleString() %></span></span>
            <% if (sig.story_id) { %>
              <a class="signal-meta-chip signal-story-link" href="/admin/stories/<%= sig.story_id %>/edit">linked story →</a>
            <% } %>
          </div>

          <div class="signal-sources">
            <% (evidence.sources || []).forEach(function(src) { %>
              <span class="signal-source-tag"><%= src %></span>
            <% }); %>
          </div>

          <div class="signal-card-actions">
            <% if (sig.status !== 'used' && sig.status !== 'dismissed') { %>
              <form method="POST" action="/admin/signals/<%= sig.id %>/create-story">
                <button type="submit">Create Story</button>
              </form>
              <form method="POST" action="/admin/signals/<%= sig.id %>/dismiss">
                <button type="submit" class="outline secondary">Dismiss</button>
              </form>
            <% } %>
            <% if (sig.story_id) { %>
              <a href="/admin/stories/<%= sig.story_id %>/edit" role="button" class="outline">View Story</a>
            <% } %>
          </div>

          <% if (sig.status !== 'dismissed') { %>
            <details class="signal-details">
              <summary>View matching articles (<%= articleIds.length %>)</summary>
              <div class="signal-evidence">
              <% if (pageData.articleMap) {
                articleIds.forEach(function(aid) {
                  const art = pageData.articleMap[aid];
                  if (art) { %>
                <div class="signal-evidence-row">
                  <% if (art.image_url) { %>
                    <img src="<%= secureUrl(art.image_url) %>" alt="" loading="lazy" width="72" referrerpolicy="no-referrer" class="signal-evidence-thumb">
                  <% } %>
                  <span class="signal-evidence-source"><%= displaySourceName(art) %></span>
                  <a href="<%= art.url %>" target="_blank" rel="noopener"><%= art.title %></a>
                  <span class="signal-evidence-date"><%= art.published_at ? new Date(art.published_at).toLocaleDateString() : '' %></span>
                </div>
                <%  }
                });
              } %>
              </div>
            </details>
          <% } %>
        </article>
      <% }); %>
    </div>
  <% } %>
</section>
