<section class="admin-dashboard">
  <h1>🐿️ Admin Dashboard</h1>
  <p>Logged in as <strong><%= user.username %></strong> (<%= user.role %>)
    — <form method="POST" action="/auth/logout" style="display:inline"><button type="submit" class="secondary outline">Log out</button></form>
  </p>

  <h2>Sources</h2>
  <table>
    <thead>
      <tr><th>Name</th><th>Slug</th><th>Type</th><th>Active</th><th>Articles</th><th>Last Fetched</th></tr>
    </thead>
    <tbody>
      <% pageData.sources.forEach(function(source) { %>
        <tr>
          <td><a href="/admin/sources/<%= source.slug %>"><%= source.name %></a></td>
          <td><%= source.slug %></td>
          <td><%= source.type %></td>
          <td><%= source.active ? '✅' : '⬜' %></td>
          <td><%= source.article_count %></td>
          <td><%= source.last_fetched_at ? new Date(source.last_fetched_at).toLocaleString() : 'never' %></td>
        </tr>
      <% }); %>
    </tbody>
  </table>
  <p class="hint">Source CRUD (add/edit/deactivate) is not yet implemented — see architecture.md refactor #13.</p>
</section>
