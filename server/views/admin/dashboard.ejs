<section>
  <h1>Admin Dashboard</h1>
  
  <div id="admin-messages"></div>
  
  <!-- User Management -->
  <article>
    <header>User Management</header>
    
    <!-- Desktop table -->
    <div class="admin-table-desktop">
      <table>
        <thead>
          <tr>
            <th>ID</th>
            <th>Username</th>
            <th>Email</th>
            <th>Role</th>
            <th>Tier</th>
            <th>Galleries</th>
            <th>Photos</th>
            <th>Status</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% if (pageData && pageData.users) { %>
            <% pageData.users.forEach(u => { %>
              <tr id="user-<%= u.id %>">
                <td><%= u.id %></td>
                <td><%= u.username %></td>
                <td><%= u.email %></td>
                <td><%= u.role %></td>
                <td>
                  <select 
                    hx-patch="/admin/users/<%= u.id %>/tier"
                    hx-target="#user-<%= u.id %>"
                    hx-swap="outerHTML"
                    name="tier"
                    style="padding: 0.25rem 0.5rem; margin: 0;">
                    <option value="free" <%= u.tier === 'free' || !u.tier ? 'selected' : '' %>>free</option>
                    <option value="event" <%= u.tier === 'event' ? 'selected' : '' %>>event ($5)</option>
                    <option value="partypack" <%= u.tier === 'partypack' ? 'selected' : '' %>>partypack ($12)</option>
                  </select>
                </td>
                <td><a href="/admin/users/<%= u.id %>/galleries"><%= u.gallery_count || 0 %></a></td>
                <td><%= u.photo_count || 0 %></td>
                <td><%= u.status %></td>
                <td>
                  <% if (u.status === 'active') { %>
                    <button hx-patch="/admin/users/<%= u.id %>/status" 
                            hx-vals='{"status":"paused"}' 
                            hx-target="#user-<%= u.id %>"
                            hx-swap="outerHTML"
                            class="outline secondary">Pause</button>
                  <% } else { %>
                    <button hx-patch="/admin/users/<%= u.id %>/status" 
                            hx-vals='{"status":"active"}' 
                            hx-target="#user-<%= u.id %>"
                            hx-swap="outerHTML"
                            class="outline">Activate</button>
                  <% } %>
                </td>
              </tr>
            <% }); %>
          <% } %>
        </tbody>
      </table>
    </div>
    
    <!-- Mobile cards -->
    <div class="admin-cards-mobile">
      <% if (pageData && pageData.users) { %>
        <% pageData.users.forEach(u => { %>
          <div class="user-card" id="user-card-<%= u.id %>">
            <div class="user-card-header">
              <strong><%= u.username %></strong>
              <span class="user-badge <%= u.tier || 'free' %>"><%= u.tier || 'free' %></span>
              <span class="user-badge <%= u.status %>"><%= u.status %></span>
            </div>
            <div class="user-card-details">
              <small><%= u.email %></small>
              <small>Role: <%= u.role %> • ID: <%= u.id %></small>
              <small><a href="/admin/users/<%= u.id %>/galleries"><%= u.gallery_count || 0 %> galleries</a> • <%= u.photo_count || 0 %> photos</small>
            </div>
            <div class="user-card-actions">
              <select 
                hx-patch="/admin/users/<%= u.id %>/tier"
                hx-target="#user-card-<%= u.id %>"
                hx-swap="outerHTML"
                name="tier"
                style="padding: 0.25rem 0.5rem; margin: 0 0.5rem 0 0;">
                <option value="free" <%= u.tier === 'free' || !u.tier ? 'selected' : '' %>>free</option>
                <option value="event" <%= u.tier === 'event' ? 'selected' : '' %>>event</option>
                <option value="partypack" <%= u.tier === 'partypack' ? 'selected' : '' %>>partypack</option>
              </select>
              <% if (u.status === 'active') { %>
                <button hx-patch="/admin/users/<%= u.id %>/status" 
                        hx-vals='{"status":"paused"}' 
                        hx-target="#user-card-<%= u.id %>"
                        hx-swap="outerHTML"
                        class="outline secondary">Pause</button>
              <% } else { %>
                <button hx-patch="/admin/users/<%= u.id %>/status" 
                        hx-vals='{"status":"active"}' 
                        hx-target="#user-card-<%= u.id %>"
                        hx-swap="outerHTML"
                        class="outline">Activate</button>
              <% } %>
            </div>
          </div>
        <% }); %>
      <% } %>
    </div>
  </article>
</section>
