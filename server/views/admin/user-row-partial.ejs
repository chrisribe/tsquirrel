<% const {user, currentUser} = pageData %>
<tr class="user-row" data-user-id="<%= user.id %>">
  <td><%= user.id %></td>
  <td><%= user.username %></td>
  <td><%= user.email %></td>
  <td>
    <span class="role-badge role-<%= user.role %>"><%= user.role %></span>
  </td>
  <td>
    <span class="status-badge status-<%= user.status || 'active' %>">
      <%= user.status || 'active' %>
    </span>
  </td>
  <td><%= user.total_events || 0 %></td>
  <td><%= user.total_photos || 0 %></td>
  <td class="actions-cell">
    <% if (user.id !== currentUser.id) { %>
      <div class="action-buttons">
        <% if (user.status !== 'paused') { %>
          <button 
            class="btn btn-warning btn-sm"
            hx-post="/admin/users/<%= user.id %>/status"
            hx-vals='{"status": "paused"}'
            hx-target="closest tr"
            hx-swap="outerHTML"
            title="Pause User">
            Pause
          </button>
        <% } else { %>
          <button 
            class="btn btn-success btn-sm"
            hx-post="/admin/users/<%= user.id %>/status"
            hx-vals='{"status": "active"}'
            hx-target="closest tr"
            hx-swap="outerHTML"
            title="Activate User">
            Activate
          </button>
        <% } %>
        
        <button 
          class="btn btn-danger btn-sm"
          hx-delete="/admin/users/<%= user.id %>"
          hx-target="closest tr"
          hx-swap="outerHTML"
          hx-confirm="Are you sure you want to delete user '<%= user.username %>'? This will mark them as deleted."
          title="Delete User">
          Delete
        </button>
      </div>
    <% } else { %>
      <span class="text-muted">Current User</span>
    <% } %>
  </td>
</tr>
