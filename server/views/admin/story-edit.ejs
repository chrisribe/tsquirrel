<%
  const isEdit = !!pageData.story;
  const story = pageData.story || {};
  const prefill = pageData.prefill || {};
  const cats = ['AI','Technology','World','Business','Science','Politics','Sports','Entertainment','Other'];
  const attachedIds = pageData.attached.map(article => article.id);
  const brief = pageData.briefForm || pageData.brief;
%>
<section class="admin-story-edit" id="story-edit-section">
  <a href="<%= pageData.returnTo || '/admin/stories' %>" class="admin-back">&larr; Back to Stories</a>
  <h1><%= isEdit ? 'Edit Story' : 'New Story' %></h1>

  <% if (pageData.message) { %><p class="admin-alert" role="status"><%= pageData.message %></p><% } %>
  <% if (pageData.error) { %><p class="admin-alert" role="alert"><%= pageData.error %></p><% } %>

  <% if (isEdit) { %>
    <%- include('partials/_story-meta', { pageData: { story } }) %>
    <nav class="story-editor-tabs" aria-label="Story editor sections" role="tablist" hidden>
      <button type="button" id="story-details-tab" class="story-editor-tab active"
              role="tab" aria-selected="true" aria-controls="story-details-panel">
        Story
      </button>
      <button type="button" id="story-sources-tab" class="story-editor-tab"
              role="tab" aria-selected="false" aria-controls="story-sources-panel" tabindex="-1">
        Sources <span class="story-editor-tab-count"><%= pageData.attached.length %></span>
      </button>
      <button type="button" id="story-brief-tab" class="story-editor-tab"
              role="tab" aria-selected="false" aria-controls="story-brief-panel" tabindex="-1">
        Dig deeper
        <% if (brief?.revision) { %>
          <span class="story-editor-tab-state is-<%= brief.status %>"><%= brief.status %></span>
        <% } %>
      </button>
    </nav>
    <section id="story-details-panel" class="story-editor-panel" role="tabpanel"
             aria-labelledby="story-details-tab">
  <% } %>

  <form id="story-form" method="POST"
        action="<%= isEdit ? '/admin/stories/' + story.id : '/admin/stories' %>"
        hx-post="<%= isEdit ? '/admin/stories/' + story.id : '/admin/stories' %>"
        hx-target="<%= isEdit ? '#save-status' : '#story-edit-section' %>"
        hx-swap="outerHTML show:none"
        hx-sync="this:replace"
        hx-disabled-elt="find button[type='submit']">
    <label>Title
      <input type="text" name="title" required value="<%= story.title || prefill.title || '' %>" placeholder="Story headline">
    </label>
    <label>Summary
      <textarea name="summary" rows="4" placeholder="2–3 sentence synthesis"><%= story.summary || prefill.summary || '' %></textarea>
    </label>
    <label>Squirrel Take <small>(short editorial one-liner, optional)</small>
      <input type="text" name="squirrel_take" value="<%= story.squirrel_take || '' %>" placeholder="Punchy opinionated take">
    </label>
    <label>Why it matters <small>(required for publish)</small>
      <textarea name="why_it_matters" rows="3" placeholder="What changes for people, institutions, or markets because of this?"><%= story.why_it_matters || '' %></textarea>
    </label>
    <div class="grid">
      <label>Category
        <select name="category">
          <% cats.forEach(function(category) { %>
            <option value="<%= category %>" <%= (story.category || 'Other') === category ? 'selected' : '' %>><%= catLabel(category) %></option>
          <% }); %>
        </select>
      </label>
      <label>Tags <small>(comma-separated)</small>
        <input type="text" name="tags" value="<%= (story.tags || []).join(', ') %>" placeholder="ai, policy, canada">
      </label>
    </div>

    <% if (!isEdit) { %>
      <fieldset>
        <legend>Attach source articles <small>(optional — drives heat score)</small></legend>
        <div class="article-picker">
          <% pageData.recentArticles.forEach(function(article) { %>
            <label class="article-picker-row">
              <input type="checkbox" name="articleIds" value="<%= article.id %>"
                <%= attachedIds.indexOf(article.id) !== -1 ? 'checked' : '' %>>
              <span class="article-picker-text">
                <small class="article-picker-source">[<%= displaySourceName(article) %>]</small>
                <span class="article-picker-title"><%= article.title %></span>
              </span>
              <a href="<%= article.url %>" target="_blank" rel="noopener noreferrer" class="article-picker-view"
                 title="Open article in new tab" onclick="event.stopPropagation()">View ↗</a>
            </label>
          <% }); %>
        </div>
      </fieldset>
    <% } %>

    <div class="admin-save-row">
      <button type="submit" class="admin-main-submit"><%= isEdit ? 'Save Changes' : 'Create Draft' %></button>
      <output id="save-status" class="admin-save-status" role="status"></output>
    </div>
  </form>

  <%- include('partials/_image-picker', { pageData: { story: pageData.story, prefill, attached: pageData.attached } }) %>

  <% if (isEdit) { %>
    <%- include('partials/_story-actions', { pageData: { story, returnTo: pageData.returnTo } }) %>
    </section>

    <section id="story-sources-panel" class="story-editor-panel" role="tabpanel"
             aria-labelledby="story-sources-tab">
      <%- include('partials/_suggested-sources', { pageData: { story, suggestions: pageData.suggestions } }) %>
      <%- include('partials/_story-sources', { pageData: { story, attached: pageData.attached } }) %>
    </section>

    <section id="story-brief-panel" class="story-editor-panel" role="tabpanel"
             aria-labelledby="story-brief-tab">
      <%- include('partials/_story-brief', {
        pageData: {
          story,
          attached: pageData.attached,
          brief
        }
      }) %>
    </section>
  <% } %>
</section>

<% if (isEdit) { %>
  <script>
    (function () {
      const tabList = document.querySelector('.story-editor-tabs');
      if (!tabList) return;

      const tabs = Array.from(tabList.querySelectorAll('[role="tab"]'));
      const panels = tabs.map(tab => document.getElementById(tab.getAttribute('aria-controls')));

      function activate(tab, moveFocus) {
        tabs.forEach((candidate, index) => {
          const selected = candidate === tab;
          candidate.classList.toggle('active', selected);
          candidate.setAttribute('aria-selected', String(selected));
          candidate.tabIndex = selected ? 0 : -1;
          panels[index].hidden = !selected;
        });
        if (moveFocus) tab.focus();
      }

      tabs.forEach((tab, index) => {
        tab.addEventListener('click', function () {
          activate(tab, false);
          history.replaceState(null, '', '#' + tab.getAttribute('aria-controls'));
        });
        tab.addEventListener('keydown', function (event) {
          if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return;
          event.preventDefault();
          let nextIndex = index;
          if (event.key === 'ArrowLeft') nextIndex = (index - 1 + tabs.length) % tabs.length;
          if (event.key === 'ArrowRight') nextIndex = (index + 1) % tabs.length;
          if (event.key === 'Home') nextIndex = 0;
          if (event.key === 'End') nextIndex = tabs.length - 1;
          activate(tabs[nextIndex], true);
          history.replaceState(null, '', '#' + tabs[nextIndex].getAttribute('aria-controls'));
        });
      });

      const hashTarget = location.hash
        ? document.getElementById(decodeURIComponent(location.hash.slice(1)))
        : null;
      const initialPanel = hashTarget?.closest('[role="tabpanel"]') || panels[0];
      const initialTab = tabs.find(tab => tab.getAttribute('aria-controls') === initialPanel.id) || tabs[0];
      activate(initialTab, false);
      tabList.hidden = false;
    })();
  </script>
<% } %>
