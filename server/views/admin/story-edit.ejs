<%
  const isEdit = !!pageData.story;
  const s = pageData.story || {};
  const cats = ['Technology','World','Business','Science','Politics','Sports','Entertainment','Other'];
  const attachedIds = pageData.attached.map(a => a.id);
%>
<section class="admin-story-edit">
  <p><a href="/admin/stories">&larr; Back to Stories</a></p>
  <h1>🐿️ <%= isEdit ? 'Edit Story' : 'New Story' %></h1>

  <% if (pageData.error) { %>
    <p style="color:var(--pico-del-color,#b00)"><strong><%= pageData.error %></strong></p>
  <% } %>

  <% if (isEdit) { %>
    <p>
      Status:
      <% if (s.status === 'published') { %>✅ published
      <% } else if (s.status === 'draft') { %>📝 draft
      <% } else { %>🙈 hidden<% } %>
      · Heat: <%= s.heat_score %> · Sources: <%= s.source_count %>
      <% if (s.is_featured) { %> · ⭐ featured<% } %>
    </p>
  <% } %>

  <!-- ── Story fields ── -->
  <form method="POST" action="<%= isEdit ? '/admin/stories/' + s.id : '/admin/stories' %>">
    <label>Title
      <input type="text" name="title" required value="<%= s.title || '' %>" placeholder="Story headline">
    </label>
    <label>Summary
      <textarea name="summary" rows="4" placeholder="2–3 sentence synthesis"><%= s.summary || '' %></textarea>
    </label>
    <label>Squirrel Take <small>(short editorial one-liner, optional)</small>
      <input type="text" name="squirrel_take" value="<%= s.squirrel_take || '' %>" placeholder="Punchy opinionated take">
    </label>
    <div class="grid">
      <label>Category
        <select name="category">
          <% cats.forEach(function(c) { %>
            <option value="<%= c %>" <%= (s.category || 'Other') === c ? 'selected' : '' %>><%= catLabel(c) %></option>
          <% }); %>
        </select>
      </label>
      <label>Tags <small>(comma-separated)</small>
        <input type="text" name="tags" value="<%= (s.tags || []).join(', ') %>" placeholder="ai, policy, canada">
      </label>
    </div>

    <% if (!isEdit) { %>
      <!-- New story: pick source articles inline (become citations on create) -->
      <fieldset>
        <legend>Attach source articles <small>(optional — drives heat score)</small></legend>
        <div class="article-picker">
          <% pageData.recentArticles.forEach(function(a) { %>
            <label class="article-picker-row">
              <input type="checkbox" name="articleIds" value="<%= a.id %>"
                <%= attachedIds.indexOf(a.id) !== -1 ? 'checked' : '' %>>
              <span class="article-picker-text">
                <small class="article-picker-source">[<%= a.source_name %>]</small>
                <span class="article-picker-title"><%= a.title %></span>
              </span>
              <a href="<%= a.url %>" target="_blank" rel="noopener noreferrer" class="article-picker-view" title="Open article in new tab" onclick="event.stopPropagation()">View ↗</a>
            </label>
          <% }); %>
        </div>
      </fieldset>
    <% } %>

    <button type="submit"><%= isEdit ? 'Save Changes' : 'Create Draft' %></button>
  </form>

  <% if (isEdit) { %>
    <!-- ── Attached sources ── -->
    <h2>Attached Sources (<%= pageData.attached.length %>)</h2>
    <% if (pageData.attached.length === 0) { %>
      <p class="hint">No sources attached yet.</p>
    <% } else { %>
      <table>
        <thead><tr><th>Title</th><th>Source</th><th></th></tr></thead>
        <tbody>
          <% pageData.attached.forEach(function(a) { %>
            <tr>
              <td><a href="<%= a.url %>" target="_blank" rel="noopener noreferrer"><%= a.title %></a></td>
              <td><%= a.source_name %></td>
              <td>
                <form method="POST" action="/admin/stories/<%= s.id %>/detach" style="display:inline">
                  <input type="hidden" name="articleId" value="<%= a.id %>">
                  <button type="submit" class="outline secondary" style="padding:.15rem .5rem">Detach</button>
                </form>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    <% } %>

    <!-- ── Attach more ── -->
    <details>
      <summary>Attach another source article</summary>
      <div class="article-picker">
        <% pageData.recentArticles.forEach(function(a) { %>
          <% if (attachedIds.indexOf(a.id) === -1) { %>
            <div class="article-picker-row">
              <span class="article-picker-text">
                <small class="article-picker-source">[<%= a.source_name %>]</small>
                <span class="article-picker-title"><%= a.title %></span>
              </span>
              <a href="<%= a.url %>" target="_blank" rel="noopener noreferrer" class="article-picker-view" title="Open article in new tab">View ↗</a>
              <form method="POST" action="/admin/stories/<%= s.id %>/attach" style="display:inline">
                <input type="hidden" name="articleId" value="<%= a.id %>">
                <button type="submit" class="outline" style="padding:.15rem .5rem">Attach</button>
              </form>
            </div>
          <% } %>
        <% }); %>
      </div>
    </details>

    <!-- ── Lifecycle ── -->
    <h2>Actions</h2>
    <div style="display:flex;gap:.5rem;flex-wrap:wrap">
      <% if (s.status !== 'published') { %>
        <form method="POST" action="/admin/stories/<%= s.id %>/publish"><button type="submit">Publish</button></form>
      <% } else { %>
        <form method="POST" action="/admin/stories/<%= s.id %>/unpublish"><button type="submit" class="secondary">Unpublish</button></form>
      <% } %>
      <% if (s.status !== 'hidden') { %>
        <form method="POST" action="/admin/stories/<%= s.id %>/hide"><button type="submit" class="outline">Hide</button></form>
      <% } %>
      <form method="POST" action="/admin/stories/<%= s.id %>/feature">
        <input type="hidden" name="featured" value="<%= s.is_featured ? 'false' : 'true' %>">
        <input type="hidden" name="returnTo" value="/admin/stories/<%= s.id %>/edit">
        <button type="submit" class="outline"><%= s.is_featured ? 'Unfeature' : 'Feature' %></button>
      </form>
      <form method="POST" action="/admin/stories/<%= s.id %>/delete" onsubmit="return confirm('Delete this story permanently?')">
        <button type="submit" class="outline" style="color:var(--pico-del-color,#b00);border-color:var(--pico-del-color,#b00)">Delete</button>
      </form>
    </div>
  <% } %>
</section>
