<section class="admin-source-articles">
  <a href="/admin" class="admin-back">&larr; Back to Admin Dashboard</a>
  <h1>🐿️ <%= pageData.source.name %></h1>
  <p class="admin-meta">
    <strong>Slug:</strong> <%= pageData.source.slug %> &middot;
    <strong>Type:</strong> <%= pageData.source.type %> &middot;
    <strong>Active:</strong> <%= pageData.source.active ? '✅' : '⬜' %> &middot;
    <strong>Feed URL:</strong> <%= pageData.source.feed_url || pageData.source.url %>
  </p>

  <h2>Recently Pulled Articles (last <%= pageData.articles.length %>)</h2>
  <% if (pageData.articles.length === 0) { %>
    <p class="hint">No articles have been ingested from this source yet.</p>
  <% } else { %>
    <div class="table-scroll">
    <table>
      <thead>
        <tr><th>Title</th><th class="nowrap">Published</th><th class="nowrap">Fetched</th><th></th></tr>
      </thead>
      <tbody>
        <% pageData.articles.forEach(function(article) { %>
          <tr>
            <td><a href="<%= article.url %>" target="_blank" rel="noopener noreferrer"><%= article.title %></a></td>
            <td class="nowrap mono"><%= article.published_at ? new Date(article.published_at).toLocaleString() : '—' %></td>
            <td class="nowrap mono"><%= new Date(article.fetched_at).toLocaleString() %></td>
            <td class="nowrap">
              <a href="/admin/stories/new?articleIds=<%= article.id %>" role="button" class="outline">Create story</a>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
    </div>
  <% } %>
</section>
