<header class="container">
  <nav>
    <ul>
      <li><a href="/" class="logo"><span class="logo-icon">⚡</span><strong>EventGlimpse</strong></a></li>
    </ul>
    <ul class="nav-right">
      <% if (user) { %>
        <li><a href="/galleries" class="nav-btn">📸 My Galleries</a></li>
        <% if (user.role === 'admin') { %>
          <li><a href="/admin" class="nav-link-subtle">Admin</a></li>
        <% } %>
        <li>
          <a href="#" hx-post="/auth/logout" hx-swap="none" class="nav-link-subtle">Logout</a>
        </li>
      <% } else { %>
        <li><a href="/auth/login" class="nav-link-subtle">Log in</a></li>
        <li><a href="/auth/register" class="nav-btn-primary">Sign up free</a></li>
      <% } %>
    </ul>
  </nav>
</header>
