<%
  const { story, articles, related } = pageData;
  function timeAgo(date) {
    const now = new Date();
    const diff = Math.floor((now - new Date(date)) / 1000);
    if (diff < 60) return `${diff}s ago`;
    if (diff < 3600) return `${Math.floor(diff/60)}m ago`;
    if (diff < 86400) return `${Math.floor(diff/3600)}h ago`;
    return `${Math.floor(diff/86400)}d ago`;
  }
  const meta = catMeta(story.category);
  const sentiment = story.sentiment != null ? Number(story.sentiment) : null;
  const needlePct = sentiment != null ? Math.round(((sentiment + 1) / 2) * 100) : 50;
  const moodReading = sentiment == null ? 'No reading yet'
    : sentiment > 0.3 ? 'Mostly excited'
    : sentiment < -0.3 ? 'Mostly skeptical'
    : 'Mixed feelings in the forest';
%>

<article class="story-detail">
  <!-- Hero -->
  <div class="story-hero <%= meta.cls %>">
    <a href="/" class="story-back-link" data-ga-event="back_to_feed" data-ga-location="story_top">← Back to trending</a>
    <% if (story.image_url) { %>
      <img src="<%= secureUrl(story.image_url) %>" alt="" loading="eager" fetchpriority="high" decoding="async" referrerpolicy="no-referrer" onerror="this.style.display='none';this.nextElementSibling.style.display='flex'">
      <span class="thumb-fallback" style="display:none"><%= meta.thumb %></span>
    <% } else { %>
      <%= meta.thumb %>
    <% } %>
  </div>

  <header class="story-detail-header">
    <div class="story-meta">
      <span class="badge <%= meta.badge %>"><%= catLabel(story.category) %></span>
      <% if (story.heat_score >= 30) { %><span class="badge badge-hot">🔥 everyone's chattering</span><% } %>
      <span class="story-time"><%= timeAgo(story.updated_at || story.created_at) %> · <%= story.source_count %> source<%= story.source_count != 1 ? 's' : '' %></span>
    </div>
    <h1><%= story.title %></h1>

    <% if (story.squirrel_take) { %>
      <div class="squirrel-take">
        <div class="squirrel-take-label">🐿️ The Squirrel's Take</div>
        <div class="squirrel-take-text"><%= story.squirrel_take %></div>
      </div>
    <% } %>

    <% if (story.why_it_matters) { %>
      <div class="why-it-matters">
        <div class="why-it-matters-label">💡 Why it matters</div>
        <div class="why-it-matters-text"><%= story.why_it_matters %></div>
      </div>
    <% } %>

    <% if (story.summary) { %>
      <p class="story-summary-large"><%= story.summary %></p>
    <% } %>
    <% if (story.tags && story.tags.length) { %>
      <div class="story-tags">
        <% story.tags.forEach(tag => { %>
          <a href="/?tag=<%= encodeURIComponent(tag) %>" class="story-tag" data-ga-event="tag_select" data-ga-tag="<%= tag %>" data-ga-location="story_header">#<%= tag %></a>
        <% }); %>
      </div>
    <% } %>
  </header>

  <!-- Forest mood -->
  <% if (sentiment != null) { %>
    <div class="sentiment-card">
      <div class="sentiment-label">🌡️ Forest Mood</div>
      <div class="sentiment-bar"><div class="sentiment-needle" style="left: <%= needlePct %>%"></div></div>
      <div class="sentiment-meta">
        <span>😤 Skeptical</span>
        <span>😐 Mixed</span>
        <span>🤩 Excited</span>
      </div>
      <div class="sentiment-reading"><%= moodReading %></div>
    </div>
  <% } %>

  <!-- Sources -->
  <section class="sources-card">
    <div class="sources-label">📡 Where we spotted it (<%= articles.length %>)</div>
    <% articles.forEach(a => { %>
      <a href="<%= a.url %>" target="_blank" rel="noopener noreferrer" class="source-row" data-ga-event="source_open" data-ga-source-name="<%= displaySourceName(a) %>" data-ga-story-id="<%= story.id %>" data-ga-story-slug="<%= story.slug %>">
        <div class="source-icon">📰</div>
        <div class="source-body">
          <div class="source-name"><%= displaySourceName(a) %></div>
          <div class="source-headline"><%= a.title %></div>
          <div class="source-time"><%= timeAgo(a.origin_at || a.fetched_at || a.published_at) %></div>
        </div>
        <div class="source-arrow">›</div>
      </a>
    <% }); %>
  </section>
</article>

<% if (related && related.length) { %>
<section class="keep-digging">
  <div class="keep-digging-label">🐿️ Keep digging</div>
  <% related.forEach(r => { %>
    <% const rMeta = catMeta(r.category); %>
    <% const rShowTake = !!String(r.squirrel_take || '').trim(); %>
    <a href="/story/<%= r.slug %>" class="keep-digging-row" data-ga-event="related_story_open" data-ga-story-id="<%= r.id %>" data-ga-story-slug="<%= r.slug %>" data-ga-location="keep_digging">
      <span class="keep-digging-icon"><%= rMeta.thumb %></span>
      <span class="keep-digging-body">
        <% if (rShowTake) { %>
          <span class="keep-digging-take">🐿️ <%= r.squirrel_take %></span>
        <% } %>
        <span class="keep-digging-title"><%= r.title %></span>
      </span>
      <span class="keep-digging-arrow">›</span>
    </a>
  <% }); %>
</section>
<% } %>

<div class="story-end-nav">
  <a href="/" class="secondary" data-ga-event="back_to_feed" data-ga-location="story_bottom">← Back to trending</a>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    if (window.tsqTrack) {
      window.tsqTrack('story_view', {
        story_id: <%= story.id %>,
        story_slug: '<%= story.slug %>',
        category: '<%= story.category %>',
        source_count: <%= story.source_count || 0 %>,
      });
    }
  });
</script>
