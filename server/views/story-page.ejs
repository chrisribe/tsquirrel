<%
  const { story, articles } = pageData;
  function timeAgo(date) {
    const now = new Date();
    const diff = Math.floor((now - new Date(date)) / 1000);
    if (diff < 60) return `${diff}s ago`;
    if (diff < 3600) return `${Math.floor(diff/60)}m ago`;
    if (diff < 86400) return `${Math.floor(diff/3600)}h ago`;
    return `${Math.floor(diff/86400)}d ago`;
  }
  const meta = catMeta(story.category);
  const sentiment = story.sentiment != null ? Number(story.sentiment) : null;
  const needlePct = sentiment != null ? Math.round(((sentiment + 1) / 2) * 100) : 50;
  const moodReading = sentiment == null ? 'No reading yet'
    : sentiment > 0.3 ? 'Mostly excited'
    : sentiment < -0.3 ? 'Mostly skeptical'
    : 'Mixed feelings in the forest';
%>

<article class="story-detail">
  <!-- Hero -->
  <div class="story-hero <%= meta.cls %>">
    <% if (story.image_url) { %>
      <img src="<%= story.image_url %>" alt="" loading="lazy" referrerpolicy="no-referrer" onerror="this.style.display='none';this.nextElementSibling.style.display='flex'">
      <span class="thumb-fallback" style="display:none"><%= meta.thumb %></span>
    <% } else { %>
      <%= meta.thumb %>
    <% } %>
  </div>

  <header class="story-detail-header">
    <div class="story-meta">
      <span class="badge <%= meta.badge %>"><%= catLabel(story.category) %></span>
      <% if (story.heat_score >= 30) { %><span class="badge badge-hot">🔥 everyone's chattering</span><% } %>
      <span class="story-time"><%= timeAgo(story.updated_at || story.created_at) %> · <%= story.source_count %> source<%= story.source_count != 1 ? 's' : '' %></span>
    </div>
    <h1><%= story.title %></h1>

    <% if (story.squirrel_take) { %>
      <div class="squirrel-take">
        <div class="squirrel-take-label">🐿️ The Squirrel's Take</div>
        <div class="squirrel-take-text"><%= story.squirrel_take %></div>
      </div>
    <% } %>

    <% if (story.summary) { %>
      <p class="story-summary-large"><%= story.summary %></p>
    <% } %>
    <% if (story.tags && story.tags.length) { %>
      <div class="story-tags">
        <% story.tags.forEach(tag => { %>
          <span class="story-tag">#<%= tag %></span>
        <% }); %>
      </div>
    <% } %>
  </header>

  <!-- Forest mood -->
  <% if (sentiment != null) { %>
    <div class="sentiment-card">
      <div class="sentiment-label">🌡️ Forest Mood</div>
      <div class="sentiment-bar"><div class="sentiment-needle" style="left: <%= needlePct %>%"></div></div>
      <div class="sentiment-meta">
        <span>😤 Skeptical</span>
        <span>😐 Mixed</span>
        <span>🤩 Excited</span>
      </div>
      <div class="sentiment-reading"><%= moodReading %></div>
    </div>
  <% } %>

  <!-- Sources -->
  <section class="sources-card">
    <div class="sources-label">📡 Where we spotted it (<%= articles.length %>)</div>
    <% articles.forEach(a => { %>
      <a href="<%= a.url %>" target="_blank" rel="noopener noreferrer" class="source-row">
        <div class="source-icon">📰</div>
        <div class="source-body">
          <div class="source-name"><%= a.source_name %></div>
          <div class="source-headline"><%= a.title %></div>
          <div class="source-time"><%= timeAgo(a.published_at) %></div>
        </div>
        <div class="source-arrow">›</div>
      </a>
    <% }); %>
  </section>
</article>

<div style="margin-top:2rem">
  <a href="/" class="secondary">← Back to trending</a>
</div>
