<!-- Eventglimpse/api/views/index.ejs -->
<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>EventGlimpse</title>
  <link rel="stylesheet" href="/static/css/pico.min.css">
  <link rel="stylesheet" href="/static/css/styles.css">
  <script src="/static/js/htmx.min.js"></script>
  <script src="/static/js/main.js"></script>
</head>
<body>
  <header class="fixed-header container-fluid">
    <nav class="container-fluid">
      <div class="logo">
        <a href="/"><img src="/static/img/logo2.png" alt="EventGlimpse Logo"></a>
      </div>
      <div class="user-menu">
        <% if (user) { %>
          <div class="dropdown">
            <button class="dropbtn"><img src="/static/img/menu.png" alt="User Icon" width="75"></button>
            <div class="dropdown-content">
              <a href="/">Home</a>
              <a href="/profile">Profile</a>
              <form hx-post="/api/auth/logout" hx-target="#message" hx-swap="innerHTML">
                <button type="submit">Logout</button>
              </form>
            </div>
          </div>
        <% } else { %>
          <button class="outline contrast">
            <a href="/login">Login</a>
          </button>
        <% } %>
      </div>
    </nav>
  </header>
  <div id="content" class="container">
    <%- body %>
  </div>
  <footer class="container" align="center">
    <p>&copy; 2023 EventGlimpse. All rights reserved.</p>
  </footer>
</body>
</html>
