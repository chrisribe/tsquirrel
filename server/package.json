{
  "name": "hello-api",
  "version": "1.0.0",
  "description": "A simple express api",
  "main": "server.js",
  "scripts": {
    "start-node": "node server.js",
    "start-nodemon": "nodemon -L server.js",
    "start": "if [ \"$NODE_ENV\" = \"dev\" ]; then npm run start-nodemon; else npm run start-node; fi"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.844.0",
    "argon2": "^0.41.1",
    "connect-pg-simple": "^10.0.0",
    "cors": "^2.8.5",
    "ejs": "^3.1.10",
    "express": "^4.17.1",
    "express-session": "^1.18.0",
    "image-size": "^2.0.2",
    "multer": "^2.0.1",
    "multer-s3": "^3.0.1",
    "pg": "^8.11.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
