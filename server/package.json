{
  "name": "hello-api",
  "version": "1.0.0",
  "description": "A simple express api",
  "main": "server.js",
  "scripts": {
    "start-node": "node server.js",
    "start-nodemon": "nodemon -L server.js",
    "start": "if [ \"$NODE_ENV\" = \"development\" ]; then npm run start-nodemon; else npm run start-node; fi"
  },
  "dependencies": {
