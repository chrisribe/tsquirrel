    "connect-pg-simple": "^10.0.0",
    "cors": "^2.8.5",
    "ejs": "^3.1.10",
    "express": "^4.17.1",
    "express-session": "^1.18.0",
    "pg": "^8.11.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
