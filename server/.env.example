# EventGlimpse Server Configuration

# Database
DATABASE_URL=postgresql://user:password@db:5432/eventglimpse
DB_HOST=db
DB_PORT=5432
DB_NAME=eventglimpse
DB_USER=user
DB_PASSWORD=password

# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
S3_BUCKET_NAME=eventglimpse

# Application
NODE_ENV=development
PORT=3000
