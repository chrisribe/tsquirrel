FROM node:20
WORKDIR /app

# Copy package.json and package-lock.json first
COPY package*.json ./

# Debug: Show what was copied
RUN ls -la && cat package.json | grep qrcode

# Install dependencies with increased memory and verbose output
RUN npm config set fetch-retry-maxtimeout 600000 && \
    npm config set fetch-retry-mintimeout 10000 && \
    npm ci --only=production --verbose || npm install --verbose

# Debug: Verify qrcode was installed
RUN npm list qrcode || echo "qrcode not found in node_modules"

# Copy the rest of the application files
COPY . .

CMD [ "npm", "run", "start" ]