DATABASE_URL=postgres://dockeruser:changeme@db:5432/appdb
DB_PASSWORD=changeme
NODE_ENV=production
PORT=3000
PUBLIC_URL=https://tsquirrel.com

# Summary model config (OpenAI-compatible)
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com
SUMMARY_MODEL=gpt-4o-mini

# R&D brief generation config (OpenRouter by default)
OPENROUTER_API_KEY=or-...
RD_BRIEF_MODEL=deepseek/deepseek-v4-flash-0731
RD_BRIEF_BASE_URL=https://openrouter.ai/api/v1

# Cron intervals in ms (defaults: 30m ingest, 1h summarize)
INGEST_INTERVAL_MS=1800000
SUMMARY_INTERVAL_MS=3600000
