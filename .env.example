# Database password (defaults to 'devpassword123' if not set)
# IMPORTANT: Set a strong password for production!
DB_PASSWORD=your-secure-password-here

# AWS S3 Configuration (required for photo uploads)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
S3_BUCKET_NAME=eventglimpse

# CDN URL for serving images (optional - Cloudflare proxied subdomain)
# Leave empty to use direct S3 URLs
# Set to your CDN subdomain for production: CDN_BASE_URL=https://photos.event-glimpse.com
CDN_BASE_URL=

# Public URL (optional - for QR code generation in dev/testing)
# Leave empty to use request host automatically
# Set to production domain for testing: PUBLIC_URL=https://event-glimpse.com
# Or use ngrok/tunneling: PUBLIC_URL=https://abc123.ngrok.io
PUBLIC_URL=

# Optional
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
